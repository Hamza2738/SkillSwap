<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.controller.suivi_tache.back.GestionProjetController"
            styleClass="app-root"
            stylesheets="@/view/css/suiviTache/back/style.css">

    <top>
        <VBox styleClass="topbar">
            <padding>
                <Insets top="14" right="22" bottom="14" left="22"/>
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="14">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <ImageView fitHeight="50" preserveRatio="true">
                        <image>
                            <Image url="@/view/image/competences/logo.png"/>
                        </image>
                    </ImageView>
                    <Label text="SkillSwap" styleClass="brand"/>
                </HBox>

                <Region HBox.hgrow="ALWAYS"/>

                <Button text="Les competence"
                        styleClass="nav-btn"
                        onAction="#compButton"/>

                <Button text="Profil"
                        styleClass="nav-btn"
                        onAction="#goProfil"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <StackPane alignment="CENTER">
            <VBox spacing="18" styleClass="page" maxWidth="1600">

                <Label text="Gestion des Projets et Tâches"
                       styleClass="page-title"/>

                <HBox spacing="18" alignment="CENTER">

                    <VBox spacing="14"
                          styleClass="card"
                          prefWidth="900"
                          HBox.hgrow="ALWAYS">

                        <Label text="Mes Projets" styleClass="card-title"/>

                        <TableView fx:id="tableProjet"
                                   styleClass="dark-table"
                                   prefHeight="300">
                            <columns>
                                <TableColumn fx:id="colProjetMail" text="Mail" prefWidth="200"/>
                                <TableColumn fx:id="colProjetTitre" text="Titre" prefWidth="250"/>
                                <TableColumn fx:id="colProjetStatut" text="Statut" prefWidth="150"/>
                                <TableColumn fx:id="colProjetDebut" text="Date début" prefWidth="120"/>
                                <TableColumn fx:id="colProjetFin" text="Date fin" prefWidth="120"/>
                                <TableColumn fx:id="colProjetDescription" text="Description" prefWidth="220"/>
                            </columns>
                        </TableView>

                        <Label text="Formulaire Projet" styleClass="card-title"/>

                        <VBox spacing="12">

                            <Label text="Titre" styleClass="field-label"/>
                            <TextField fx:id="projetTitreField" styleClass="input"/>

                            <Label text="Description" styleClass="field-label"/>
                            <TextArea fx:id="projetDescriptionField"
                                      styleClass="input"
                                      prefRowCount="3"/>

                            <HBox spacing="10">
                                <VBox HBox.hgrow="ALWAYS">
                                    <Label text="Date début" styleClass="field-label"/>
                                    <DatePicker fx:id="projetDebutPicker"
                                                maxWidth="Infinity"
                                                styleClass="dark-date-picker"/>
                                </VBox>

                                <VBox HBox.hgrow="ALWAYS">
                                    <Label text="Date fin" styleClass="field-label"/>
                                    <DatePicker fx:id="projetFinPicker"
                                                maxWidth="Infinity"
                                                styleClass="dark-date-picker"/>
                                </VBox>
                            </HBox>

                            <Label text="Statut" styleClass="field-label"/>
                            <ComboBox fx:id="projetStatutBox"
                                      styleClass="input dark-combo"/>
                        </VBox>

                        <HBox spacing="10">
                            <Button text="Ajouter"
                                    onAction="#ajouterProjet"
                                    styleClass="btn"/>

                            <Button fx:id="btnModifierProjet"
                                    text="Modifier"
                                    onAction="#modifierProjet"
                                    styleClass="btn"/>

                            <Button fx:id="btnSupprimerProjet"
                                    text="Supprimer"
                                    onAction="#supprimerProjet"
                                    styleClass="btn"/>

                            <Button text="Vider"
                                    onAction="#viderFormProjet"
                                    styleClass="btn"/>
                        </HBox>
                    </VBox>

                    <VBox spacing="14"
                          styleClass="card"
                          HBox.hgrow="ALWAYS"
                          prefWidth="900">

                        <Label text="Tâches du Projet"
                               styleClass="card-title"/>

                        <TableView fx:id="tableTache"
                                   styleClass="dark-table"
                                   prefHeight="300">
                            <columns>
                                <TableColumn fx:id="colTacheMail" text="Mail" prefWidth="180"/>
                                <TableColumn fx:id="colTitre" text="Titre" prefWidth="200"/>
                                <TableColumn fx:id="colStatut" text="Statut" prefWidth="120"/>
                                <TableColumn fx:id="colPriorite" text="Priorité" prefWidth="120"/>
                                <TableColumn fx:id="colEvaluation" text="Evaluation" prefWidth="140"/>
                                <TableColumn fx:id="colEcheance" text="Échéance" prefWidth="160"/>
                            </columns>
                        </TableView>

                        <Label text="Formulaire Tâche"
                               styleClass="card-title"/>

                        <VBox spacing="20">

                            <Label text="Titre" styleClass="field-label"/>
                            <TextField fx:id="titreField" styleClass="input"/>

                            <Label text="Description" styleClass="field-label"/>
                            <TextArea fx:id="descriptionField"
                                      styleClass="input"
                                      prefRowCount="3"/>

                            <HBox spacing="10">
                                <VBox HBox.hgrow="ALWAYS">
                                    <Label text="Statut" styleClass="field-label"/>
                                    <ComboBox fx:id="statutBox"
                                              styleClass="input dark-combo"/>
                                </VBox>

                                <VBox HBox.hgrow="ALWAYS">
                                    <Label text="Priorité" styleClass="field-label"/>
                                    <ComboBox fx:id="prioriteBox"
                                              styleClass="input dark-combo"/>
                                </VBox>

                                <VBox HBox.hgrow="ALWAYS">
                                    <Label text="Evaluation" styleClass="field-label"/>
                                    <ComboBox fx:id="evaluationBox"
                                              styleClass="input dark-combo"/>
                                </VBox>
                            </HBox>

                            <Label text="Échéance" styleClass="field-label"/>
                            <DatePicker fx:id="echeancePicker"
                                        maxWidth="180"
                                        styleClass="dark-date-picker"/>
                        </VBox>

                        <HBox spacing="10">
                            <Button fx:id="btnAjouterTache"
                                    text="Ajouter Tâche"
                                    onAction="#ajouterTache"
                                    styleClass="btn"/>

                            <Button fx:id="btnModifierTache"
                                    text="Modifier"
                                    onAction="#modifierTache"
                                    styleClass="btn"/>

                            <Button fx:id="btnSupprimerTache"
                                    text="Supprimer"
                                    onAction="#supprimerTache"
                                    styleClass="btn"/>

                            <Button text="Vider"
                                    onAction="#viderForm"
                                    styleClass="btn"/>
                        </HBox>
                    </VBox>

                </HBox>
            </VBox>
        </StackPane>
    </center>
</BorderPane>