parameters:
    level: 8
    paths:
        - src

    # Désactiver les faux positifs liés aux PHPDoc Symfony/Doctrine
    treatPhpDocTypesAsCertain: false

    ignoreErrors:
        # Faux positifs Doctrine : $id est assigné par GeneratedValue, pas dans le code PHP
        - '#Property .+::\$id \(int\|null\) is never assigned int#'
        - '#Property .+::\$idUtilisateur \(int\|null\) is never assigned int#'

        # Faux positifs Doctrine : propriétés avec valeur par défaut non-null
        - '#Property .+::\$role \(string\|null\) is never assigned null#'
        - '#Property .+::\$statut \(string\|null\) is never assigned null#'

        # Propriétés de l'entité Offre jamais lues (entité incomplète sans getters)
        - '#Property App\\Entity\\Offre::.+ is never read, only written#'
        - '#Property App\\Entity\\Offre::.+ is never assigned#'

        # UtilisateurService est un service PDO procédural legacy — ignoré volontairement
        - '#App\\Service\\UtilisateurService#'

        # Message.php ligne 287 : comparaison string === null toujours fausse (logique intentionnelle)
        - '#Strict comparison using === between string and null will always evaluate to false#'
