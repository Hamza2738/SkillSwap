{% extends 'base.html.twig' %}

{% block title %}SkillSwap – Bienvenue{% endblock %}

{% block stylesheets %}
<style>
    *, *::before, *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    html, body {
        width: 100%;
        height: 100%;
        overflow-x: hidden;
        background: #0d1b2a;
    }

    .app-root {
        display: flex;
        flex-direction: column;
        min-height: 100vh;
        font-family: 'Segoe UI', sans-serif;
    }

    /* ── TOPBAR ── */
    .topbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 24px;
        height: 60px;
        background-color: #0f1c2e;
        border-bottom: 1px solid rgba(255,255,255,0.08);
        position: relative;
        z-index: 100;
        flex-shrink: 0;
    }

    .brand-wrapper {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .brand-wrapper img {
        height: 40px;
        object-fit: contain;
    }

    .brand {
        font-size: 1.3rem;
        font-weight: 700;
        color: #ffffff;
    }

    .nav-links {
        display: flex;
        gap: 10px;
    }

    .nav-btn {
        padding: 6px 18px;
        border: 1px solid rgba(255,255,255,0.25);
        border-radius: 6px;
        text-decoration: none;
        color: #e0e0e0;
        font-size: 0.9rem;
        background: transparent;
        transition: background 0.2s;
    }

    .nav-btn:hover {
        background: rgba(255,255,255,0.12);
        color: #ffffff;
    }

    /* ── HERO ── */
    .hero {
        position: relative;
        flex: 1;
        min-height: calc(100vh - 60px - 50px);
        overflow: hidden;
    }

    .hero-bg {
        position: absolute;
        top: 0; 
        left: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center;
        z-index: 0;
    }

    .hero::before {
        content: '';
        position: absolute;
        inset: 0;
        background: rgba(0,0,0,0.30);
        z-index: 1;
    }

    .hero-content {
        position: relative;
        z-index: 2;
        display: flex;
        align-items: center;
        gap: 40px;
        padding: 80px 50px;
        min-height: calc(100vh - 60px - 50px);
    }

    .hero-logo {
        width: 280px;
        max-width: 28%;
        object-fit: contain;
        flex-shrink: 0;
        filter: drop-shadow(0 4px 20px rgba(0,0,0,0.6));
    }

    .hero-card {
        background: rgba(0,0,0,0.58);
        border-radius: 15px;
        padding: 35px 32px;
        max-width: 600px;
        display: flex;
        flex-direction: column;
        gap: 24px;
        backdrop-filter: blur(6px);
        -webkit-backdrop-filter: blur(6px);
    }

    .hero-card h1 {
        font-size: 2rem;
        color: #ffffff;
        font-weight: bold;
        line-height: 1.2;
    }

    .hero-card p {
        font-size: 0.92rem;
        color: #e8e8e8;
        line-height: 1.75;
    }

    .btn {
        display: inline-block;
        width: 200px;
        height: 45px;
        line-height: 45px;
        text-align: center;
        background: #5b8dee;
        color: #ffffff;
        border-radius: 8px;
        text-decoration: none;
        font-weight: 600;
        font-size: 0.95rem;
        transition: background 0.2s, transform 0.1s;
        border: none;
        cursor: pointer;
    }

    .btn:hover {
        background: #3a6fd8;
        transform: translateY(-1px);
    }

    /* ── FOOTER ── */
    .footer {
        background-color: #0a1520;
        border-top: 1px solid rgba(255,255,255,0.07);
        padding: 0 24px;
        height: 50px;
        flex-shrink: 0;
    }

    .footer-hbox {
        display: flex;
        align-items: center;
        gap: 60px;
        height: 100%;
        flex-wrap: wrap;
    }

    .footer-label {
        font-weight: 700;
        color: #ffffff;
        font-size: 0.88rem;
        white-space: nowrap;
    }

    .footer-info {
        color: #a0b0c0;
        font-size: 0.85rem;
        white-space: nowrap;
    }
</style>
{% endblock %}

{% block body %}

<audio id="bgMusic" autoplay loop preload="auto">
    <source src="{{ asset('files/music/music.mp3') }}" type="audio/mpeg">
</audio>

<div class="app-root">

    {# ─── TOPBAR ─── #}
    <nav class="topbar">
        <div class="brand-wrapper">
            <img src="{{ asset('image/logo.png') }}" alt="Logo">
            <span class="brand">SkillSwap</span>
        </div>

        <div class="nav-links">
            <a href="{{ path('app_login') }}" class="nav-btn">Connectée</a>
        </div>
    </nav>

    {# ─── HERO ─── #}
    <section class="hero">
        <img
            src="{{ asset('image/business_image.jpg') }}"
            alt="Background"
            class="hero-bg"
        >

        <div class="hero-content">

            <img
                src="{{ asset('image/logo.png') }}"
                alt="SkillSwap Logo"
                class="hero-logo"
            >

            <div class="hero-card">
                <h1>Bienvenue sur SkillSwap</h1>

                <p>
                    SkillSwap est une application numérique innovante dédiée à la mise en relation
                    de professionnels souhaitant échanger leurs compétences dans un cadre structuré
                    et sécurisé. Conçue pour répondre aux besoins des entrepreneurs, freelances et
                    jeunes talents évoluant dans un environnement compétitif, la plateforme repose
                    sur un modèle collaboratif favorisant l'apprentissage mutuel sans transaction
                    financière. Elle intègre des modules complets de gestion des utilisateurs, des
                    compétences, des rendez-vous, des tâches ainsi que des offres et candidatures,
                    garantissant une organisation efficace et un suivi rigoureux des interactions.
                </p>

                <a href="{{ path('app_login') }}" class="btn">Se connecter</a>
            </div>

        </div>
    </section>

    {# ─── FOOTER ─── #}
    <footer class="footer">
        <div class="footer-hbox">
            <span class="footer-label">📞 Contactez-nous</span>
            <span class="footer-info">📱 Tél : 27387490</span>
            <span class="footer-info">📧 Email : contact@skillswap.com</span>
            <span class="footer-info">🌐 Facebook : /SkillSwap</span>
        </div>
    </footer>

</div>
<script>
    document.addEventListener('DOMContentLoaded', function () {
        const music = document.getElementById('bgMusic');

        if (music) {
            music.volume = 0.50;

            const playPromise = music.play();

            if (playPromise !== undefined) {
                playPromise.catch(function () {
                    document.addEventListener('click', function playMusicOnce() {
                        music.play();
                        document.removeEventListener('click', playMusicOnce);
                    });
                });
            }
        }
    });
</script>

{% endblock %}