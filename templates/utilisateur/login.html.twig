{% extends 'base.html.twig' %}

{% block title %}SkillSwap – Connexion{% endblock %}

{% block stylesheets %}
<link rel="stylesheet" href="{{ asset('css/utilisateur/login/style.css') }}">

<style>
    /* =========================
       MODAL MOT DE PASSE OUBLIÉ
    ========================= */
    .modal {
        display: none;
        position: fixed;
        inset: 0;
        z-index: 9999;
        background: rgba(0, 0, 0, 0.65);
        backdrop-filter: blur(4px);
    }

    .modal-content {
        width: 100%;
        max-width: 430px;
        margin: 8% auto;
        background: #111827;
        border: 1px solid #1f2937;
        border-radius: 16px;
        padding: 26px;
        color: #e2e8f0;
        box-shadow: 0 18px 40px rgba(0,0,0,.35);
        position: relative;
    }

    .modal-content h2 {
        margin-bottom: 10px;
        font-size: 28px;
    }

    .modal-content p {
        color: #94a3b8;
        margin-bottom: 18px;
        line-height: 1.5;
    }

    .close-btn {
        position: absolute;
        top: 10px;
        right: 14px;
        font-size: 24px;
        cursor: pointer;
        color: #cbd5e1;
    }

    .close-btn:hover {
        color: white;
    }

    .modal .input {
        width: 100%;
        margin-bottom: 14px;
    }

    .modal .btn {
        width: 100%;
    }

    .msg {
        padding: 12px 14px;
        border-radius: 10px;
        margin-bottom: 14px;
        font-size: 14px;
    }

    .msg-success {
        background: rgba(34,197,94,.12);
        border: 1px solid rgba(34,197,94,.35);
        color: #4ade80;
    }

    .msg-error {
        background: rgba(239,68,68,.12);
        border: 1px solid rgba(239,68,68,.35);
        color: #f87171;
    }

    /* =========================
       PASSWORD + EYE ICON
    ========================= */
    .password-wrapper {
        position: relative;
        width: 100%;
    }

    .password-wrapper .password-input {
        width: 100%;
        padding-right: 48px !important;
    }

    .eye-btn {
        position: absolute;
        top: 50%;
        right: 12px;
        transform: translateY(-50%);
        width: 30px;
        height: 30px;
        border: none;
        background: transparent;
        padding: 0;
        margin: 0;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 5;
    }

    .eye-btn img {
        width: 18px;
        height: 18px;
        object-fit: contain;
        opacity: 0.85;
        transition: opacity 0.2s ease, transform 0.2s ease;
        pointer-events: none;
    }

    .eye-btn:hover img {
        opacity: 1;
        transform: scale(1.08);
    }

    .eye-btn:focus {
        outline: none;
    }
</style>
{% endblock %}

{% block body %}
<div class="app-root">

    <img src="{{ asset('image/business_image.jpg') }}" alt="bg" class="bg-image">

    <div class="page">
        <div class="logo-wrapper">
            <img src="{{ asset('image/logo.png') }}" alt="SkillSwap Logo" class="logo">
        </div>

        <div class="card">
            <h2 class="card-title">Connexion</h2>

            {% if error %}
                <div class="hint error">
                    {{ error.messageKey|trans(error.messageData, 'security') }}
                </div>
            {% endif %}

            {% for msg in app.flashes('success') %}
                <div class="hint success">{{ msg }}</div>
            {% endfor %}

            {{ form_start(loginForm, {
                'action': path('app_login'),
                'method': 'POST'
            }) }}

                <div class="field-wrapper">
                    {{ form_widget(loginForm.email, {
                        'attr': {
                            'class': 'input',
                            'placeholder': 'Email',
                            'autocomplete': 'email',
                            'list': 'email-suggestions'
                        }
                    }) }}

                    <datalist id="email-suggestions"></datalist>

                    {{ form_errors(loginForm.email) }}
                </div>

                <div class="password-wrapper">
                    {{ form_widget(loginForm.password, {
                        'attr': {
                            'class': 'input password-input',
                            'placeholder': 'Mot de passe',
                            'autocomplete': 'current-password',
                            'id': 'password'
                        }
                    }) }}

                    <button
                        type="button"
                        class="eye-btn"
                        id="togglePassword"
                        aria-label="Afficher le mot de passe"
                    >
                        <img
                            src="{{ asset('files/utilisateur/yeux.png') }}"
                            alt="Afficher"
                            id="eyeIcon"
                            width="18"
                            height="18"
                        >
                    </button>

                    {{ form_errors(loginForm.password) }}
                </div>

                <a href="javascript:void(0)" class="forgot-link" id="openForgotModal">
                    Mot de passe oublié ?
                </a>

                <div class="checkbox-wrapper">
                    {{ form_widget(loginForm.not_robot) }}
                    {{ form_label(loginForm.not_robot) }}
                    {{ form_errors(loginForm.not_robot) }}
                </div>

                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                {{ form_widget(loginForm.submit) }}

            {{ form_end(loginForm) }}

            <a href="{{ path('app_inscription') }}" class="btn btn-outline">Créer un compte</a>
            <a href="{{ path('app_accueil') }}" class="btn btn-outline">Retour à l'accueil</a>
        </div>
    </div>
</div>

<div id="forgotModal" class="modal">
    <div class="modal-content">
        <span class="close-btn" id="closeForgotModal">&times;</span>

        <h2>Mot de passe oublié</h2>
        <p>Saisissez votre adresse email. Un mot de passe temporaire vous sera envoyé.</p>

        <div id="forgotMessage"></div>

        <input
            type="email"
            id="forgotEmail"
            class="input"
            placeholder="Votre adresse email"
        >

        <button type="button" class="btn" id="sendForgotBtn">Envoyer</button>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {

    /* =========================
       AFFICHER / MASQUER PASSWORD
    ========================= */
    const toggleBtn = document.getElementById('togglePassword');
    const passwordInput = document.getElementById('password');
    const eyeIcon = document.getElementById('eyeIcon');

    const eyeOpen = "{{ asset('files/utilisateur/yeux.png') }}";
    const eyeOff = "{{ asset('files/utilisateur/yeux_off.png') }}";

    if (toggleBtn && passwordInput && eyeIcon) {
        toggleBtn.addEventListener('click', function () {
            const isHidden = passwordInput.type === 'password';

            if (isHidden) {
                passwordInput.type = 'text';
                eyeIcon.src = eyeOff;
                eyeIcon.alt = 'Masquer';
                toggleBtn.setAttribute('aria-label', 'Masquer le mot de passe');
            } else {
                passwordInput.type = 'password';
                eyeIcon.src = eyeOpen;
                eyeIcon.alt = 'Afficher';
                toggleBtn.setAttribute('aria-label', 'Afficher le mot de passe');
            }

            passwordInput.focus();

            const length = passwordInput.value.length;
            passwordInput.setSelectionRange(length, length);
        });
    }

    /* =========================
       EMAIL HISTORY SUGGESTIONS
    ========================= */
    const emailInput = document.getElementById('{{ loginForm.email.vars.id }}');
    const datalist = document.getElementById('email-suggestions');

    function loadSuggestions() {
        if (!datalist) return;

        const history = JSON.parse(localStorage.getItem('emailHistory') || '[]');

        datalist.innerHTML = '';

        history.forEach(function(email) {
            const opt = document.createElement('option');
            opt.value = email;
            datalist.appendChild(opt);
        });
    }

    function saveEmail(email) {
        if (!email) return;

        let history = JSON.parse(localStorage.getItem('emailHistory') || '[]');

        if (!history.includes(email)) {
            history.unshift(email);

            if (history.length > 10) {
                history.pop();
            }

            localStorage.setItem('emailHistory', JSON.stringify(history));
        }
    }

    loadSuggestions();

    if (emailInput) {
        emailInput.addEventListener('focus', loadSuggestions);
    }

    const loginForm = document.querySelector('form');

    if (loginForm && emailInput) {
        loginForm.addEventListener('submit', function () {
            saveEmail(emailInput.value.trim());
        });
    }

    /* =========================
       MODAL MOT DE PASSE OUBLIÉ
    ========================= */
    const forgotModal = document.getElementById('forgotModal');
    const openForgotModal = document.getElementById('openForgotModal');
    const closeForgotModal = document.getElementById('closeForgotModal');
    const forgotEmail = document.getElementById('forgotEmail');
    const sendForgotBtn = document.getElementById('sendForgotBtn');
    const forgotMessage = document.getElementById('forgotMessage');

    function showForgotMessage(type, text) {
        if (!forgotMessage) return;

        forgotMessage.innerHTML =
            '<div class="msg ' + (type === 'success' ? 'msg-success' : 'msg-error') + '">' + text + '</div>';
    }

    function openModal() {
        if (!forgotModal) return;

        forgotModal.style.display = 'block';

        if (forgotMessage) {
            forgotMessage.innerHTML = '';
        }

        if (emailInput && forgotEmail) {
            forgotEmail.value = emailInput.value.trim();
        }

        if (forgotEmail) {
            forgotEmail.focus();
        }
    }

    function closeModal() {
        if (!forgotModal) return;
        forgotModal.style.display = 'none';
    }

    if (openForgotModal) {
        openForgotModal.addEventListener('click', function (e) {
            e.preventDefault();
            openModal();
        });
    }

    if (closeForgotModal) {
        closeForgotModal.addEventListener('click', function () {
            closeModal();
        });
    }

    window.addEventListener('click', function (e) {
        if (e.target === forgotModal) {
            closeModal();
        }
    });

    window.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') {
            closeModal();
        }
    });

    if (sendForgotBtn) {
        sendForgotBtn.addEventListener('click', async function () {
            const email = forgotEmail ? forgotEmail.value.trim() : '';

            if (!email) {
                showForgotMessage('error', 'Veuillez saisir votre adresse email.');
                return;
            }

            sendForgotBtn.disabled = true;
            sendForgotBtn.textContent = 'Envoi...';

            try {
                const response = await fetch("{{ path('app_forgot_password') }}", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/x-www-form-urlencoded",
                        "X-Requested-With": "XMLHttpRequest"
                    },
                    body: "email=" + encodeURIComponent(email)
                });

                const data = await response.json();

                if (data.success) {
                    showForgotMessage('success', data.message);
                } else {
                    showForgotMessage('error', data.message || 'Erreur.');
                }

            } catch (e) {
                showForgotMessage('error', 'Erreur serveur lors de l’envoi.');
            } finally {
                sendForgotBtn.disabled = false;
                sendForgotBtn.textContent = 'Envoyer';
            }
        });
    }
});
</script>
{% endblock %}