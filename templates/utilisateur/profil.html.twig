{% if not is_visiting %}
<script>
document.addEventListener('DOMContentLoaded', function () {
    const miniChat = document.getElementById('miniChat');
    const miniChatFrame = document.getElementById('miniChatFrame');
    const miniChatName = document.getElementById('miniChatName');
    const miniChatAvatar = document.getElementById('miniChatAvatar');
    const miniChatAvatarPlaceholder = document.getElementById('miniChatAvatarPlaceholder');
    const miniChatClose = document.getElementById('miniChatClose');
    const miniChatMin = document.getElementById('miniChatMin');

    function openMiniChat(row) {
        if (!row || !miniChat || !miniChatFrame) return;

        const url = row.dataset.chatUrl;
        const name = row.dataset.chatName;
        const avatar = row.dataset.chatAvatar;
        const initial = row.dataset.chatInitial || 'U';

        if (!url) {
            console.error('URL conversation manquante sur le contact');
            return;
        }

        miniChatName.textContent = name || 'Conversation';

        if (avatar) {
            miniChatAvatar.src = avatar;
            miniChatAvatar.style.display = 'block';
            miniChatAvatarPlaceholder.style.display = 'none';
        } else {
            miniChatAvatar.src = '';
            miniChatAvatar.style.display = 'none';
            miniChatAvatarPlaceholder.textContent = initial;
            miniChatAvatarPlaceholder.style.display = 'flex';
        }

        miniChatFrame.src = url + '?mini=1';
        miniChat.classList.add('is-open');
        miniChat.classList.remove('minimized');
    }

    document.addEventListener('click', function (event) {
        const row = event.target.closest('.js-open-mini-chat');
        if (!row) return;

        event.preventDefault();
        openMiniChat(row);
    });

    document.addEventListener('keydown', function (event) {
        if (event.key !== 'Enter') return;

        const row = event.target.closest('.js-open-mini-chat');
        if (!row) return;

        event.preventDefault();
        openMiniChat(row);
    });

    if (miniChatClose) {
        miniChatClose.addEventListener('click', function () {
            miniChat.classList.remove('is-open');
            miniChatFrame.src = '';
        });
    }

    if (miniChatMin) {
        miniChatMin.addEventListener('click', function () {
            miniChat.classList.toggle('minimized');
        });
    }
});
</script>
{% endif %}

<script>
let currentSkillIndex = 0;

function changeSkill(direction) {
    const slides = document.querySelectorAll('.skill-slide');
    const counter = document.getElementById('skillCounter');

    if (!slides.length) return;

    slides[currentSkillIndex].style.display = 'none';

    currentSkillIndex += direction;

    if (currentSkillIndex < 0) {
        currentSkillIndex = slides.length - 1;
    }

    if (currentSkillIndex >= slides.length) {
        currentSkillIndex = 0;
    }

    slides[currentSkillIndex].style.display = 'block';

    if (counter) {
        counter.textContent = 'Compétence ' + (currentSkillIndex + 1) + ' / ' + slides.length;
    }
}

document.addEventListener('DOMContentLoaded', function () {
    const miniChat = document.getElementById('miniChat');
    const miniChatFrame = document.getElementById('miniChatFrame');
    const miniChatName = document.getElementById('miniChatName');
    const miniChatAvatar = document.getElementById('miniChatAvatar');
    const miniChatAvatarPlaceholder = document.getElementById('miniChatAvatarPlaceholder');
    const miniChatClose = document.getElementById('miniChatClose');
    const miniChatMin = document.getElementById('miniChatMin');

    document.querySelectorAll('.js-open-mini-chat').forEach(function (row) {
        row.addEventListener('click', function () {
            const url = this.dataset.chatUrl;
            const name = this.dataset.chatName;
            const avatar = this.dataset.chatAvatar;
            const initial = this.dataset.chatInitial || 'U';

            if (!miniChat || !miniChatFrame) return;

            miniChatName.textContent = name || 'Conversation';

            if (avatar) {
                miniChatAvatar.src = avatar;
                miniChatAvatar.style.display = 'block';
                miniChatAvatarPlaceholder.style.display = 'none';
            } else {
                miniChatAvatar.src = '';
                miniChatAvatar.style.display = 'none';
                miniChatAvatarPlaceholder.textContent = initial;
                miniChatAvatarPlaceholder.style.display = 'flex';
            }

            miniChatFrame.src = url + '?mini=1';
            miniChat.classList.add('is-open');
            miniChat.classList.remove('minimized');
        });
    });

    if (miniChatClose) {
        miniChatClose.addEventListener('click', function () {
            miniChat.classList.remove('is-open');
            miniChatFrame.src = '';
        });
    }

    if (miniChatMin) {
        miniChatMin.addEventListener('click', function () {
            miniChat.classList.toggle('minimized');
        });
    }
});

document.addEventListener('DOMContentLoaded', function () {
    const openBtn = document.getElementById('openReseauModal');
    const modal = document.getElementById('reseauModal');
    const overlay = document.getElementById('reseauModalOverlay');
    const closeBtn = document.getElementById('closeReseauModal');
    const minimizeBtn = document.getElementById('minimizeReseauModal');

    function openReseauModal() {
        if (!modal || !overlay) return;
        modal.classList.add('is-open');
        overlay.classList.add('is-open');
    }

    function closeReseauModal() {
        if (!modal || !overlay) return;
        modal.classList.remove('is-open');
        overlay.classList.remove('is-open');
    }

    if (openBtn) {
        openBtn.addEventListener('click', openReseauModal);
    }

    if (closeBtn) {
        closeBtn.addEventListener('click', closeReseauModal);
    }

    if (overlay) {
        overlay.addEventListener('click', closeReseauModal);
    }

    if (minimizeBtn) {
        minimizeBtn.addEventListener('click', closeReseauModal);
    }

    document.addEventListener('keydown', function (event) {
        if (event.key === 'Escape') {
            closeReseauModal();
        }
    });
});

</script>
<script>
document.addEventListener('DOMContentLoaded', function () {
    const userSearchInput = document.getElementById('userSearchInput');
    const userSearchResults = document.getElementById('userSearchResults');
    let searchTimer = null;

    function escapeHtml(value) {
        return String(value)
            .replaceAll('&', '&amp;')
            .replaceAll('<', '&lt;')
            .replaceAll('>', '&gt;')
            .replaceAll('"', '&quot;')
            .replaceAll("'", '&#039;');
    }

    function closeSearchResults() {
        if (!userSearchResults) return;
        userSearchResults.classList.remove('is-open');
        userSearchResults.innerHTML = '';
    }

    function renderSearchResults(users) {
        if (!userSearchResults) return;

        userSearchResults.innerHTML = '';

        if (!users.length) {
            userSearchResults.innerHTML = '<div class="search-result-empty">Aucun utilisateur trouvé.</div>';
            userSearchResults.classList.add('is-open');
            return;
        }

        users.forEach(function (user) {
            const item = document.createElement('div');
            item.className = 'search-result-item';
            item.dataset.url = user.profileUrl;

            const initial = ((user.prenom || user.nom || 'U').charAt(0)).toUpperCase();

            const avatar = user.photoUrl
                ? '<img src="' + user.photoUrl + '" class="search-result-avatar" alt="Photo">'
                : '<div class="search-result-placeholder">' + initial + '</div>';

            item.innerHTML =
                avatar +
                '<div class="search-result-info">' +
                    '<div class="search-result-name">' +
                        escapeHtml((user.nom || '') + ' ' + (user.prenom || '')) +
                    '</div>' +
                    '<div class="search-result-meta">' +
                        escapeHtml((user.role || 'utilisateur') + ' · ' + (user.email || '')) +
                    '</div>' +
                '</div>';

            item.addEventListener('mousedown', function (event) {
                event.preventDefault();
                window.location.href = this.dataset.url;
            });

            userSearchResults.appendChild(item);
        });

        userSearchResults.classList.add('is-open');
    }

    if (userSearchInput && userSearchResults) {
        userSearchInput.addEventListener('input', function () {
            const q = this.value.trim();
            const url = this.dataset.searchUrl;

            clearTimeout(searchTimer);

           if (q.length < 1) {
    closeSearchResults();

    const homeUrl = this.dataset.homeUrl || '/profil';

    if (window.location.search.includes('q=')) {
        window.location.href = homeUrl;
    }

    return;
}

            searchTimer = setTimeout(function () {
                fetch(url + '?q=' + encodeURIComponent(q), {
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                })
                    .then(function (response) {
                        return response.json();
                    })
                    .then(function (users) {
                        renderSearchResults(users);
                    })
                    .catch(function () {
                        closeSearchResults();
                    });
            }, 120);
        });

        userSearchInput.addEventListener('keydown', function (event) {
            if (event.key === 'Escape') {
                closeSearchResults();
            }
        });

        document.addEventListener('click', function (event) {
            if (!event.target.closest('.search-box')) {
                closeSearchResults();
            }
        });
    }
});
</script>
