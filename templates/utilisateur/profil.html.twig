{% extends 'base.html.twig' %}

{% block title %}Mon Profil · SkillSwap{% endblock %}

{% block stylesheets %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<style>
*,
*::before,
*::after {
    box-sizing: border-box;
}

:root {
    --bg-main: #050b18;
    --bg-top: #0b1324;
    --bg-sidebar: #081226;
    --bg-input: #1b263b;
    --border: #26354f;
    --text: #f8fafc;
    --muted: #94a3b8;
    --blue: #6c8cff;
    --purple: #7c5cff;
    --green: #22c55e;
    --red: #ef4444;
    --gold: #facc15;
}

html,
body {
    margin: 0;
    padding: 0;
    background: var(--bg-main);
    color: var(--text);
    font-family: "Inter", Arial, sans-serif;
    font-size: 13px;
}

a {
    color: inherit;
    text-decoration: none;
}
/* ================= SEARCH DROPDOWN ================= */

.search-box {
    position: relative;
    width: 100%;
}

.search-results {
    position: absolute;
    top: 46px;
    left: 0;
    right: 0;
    background: #0b1324;
    border: 1px solid #26354f;
    border-radius: 0 0 14px 14px;
    box-shadow: 0 18px 45px rgba(0, 0, 0, .45);
    padding: 7px;
    z-index: 10000;
    display: none;
}

.search-results.is-open {
    display: block;
}

.search-result-item {
    width: 100%;
    min-height: 74px;
    border-radius: 10px;
    background: #081226;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 12px;
    cursor: pointer;
    transition: .15s ease;
}

.search-result-item:hover {
    background: #111c33;
}

.search-result-avatar {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    object-fit: cover;
    background: #243252;
    flex-shrink: 0;
}

.search-result-placeholder {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: linear-gradient(135deg, #4f83ff, #7c5cff);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    flex-shrink: 0;
}

.search-result-info {
    min-width: 0;
}

.search-result-name {
    color: #ffffff;
    font-size: 14px;
    font-weight: 800;
    margin-bottom: 3px;
}

.search-result-meta {
    color: #cbd5e1;
    font-size: 12px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.search-result-empty {
    color: #94a3b8;
    font-size: 13px;
    padding: 12px;
}
button,
input,
textarea {
    font-family: inherit;
}

/* ================= TOPBAR ================= */

.topbar {
    height: 64px;
    background: var(--bg-top);
    border-bottom: 1px solid #1e293b;
    display: flex;
    align-items: center;
    gap: 18px;
    padding: 0 22px;
}

.brand {
    min-width: 130px;
    color: #ffffff;
    font-size: 18px;
    font-weight: 800;
}

.search-wrap {
    flex: 1;
    display: flex;
    justify-content: center;
}

.search-form {
    width: 100%;
    max-width: 430px;
    display: flex;
    align-items: center;
    gap: 12px;
}

.search-input {
    width: 100%;
    height: 38px;
    border-radius: 14px;
    border: 1px solid #40516d;
    background: #182235;
    color: #e5e7eb;
    padding: 0 16px;
    outline: none;
    font-size: 13px;
}

.search-input::placeholder {
    color: #64748b;
}

.search-input:focus {
    border-color: #6c8cff;
    box-shadow: 0 0 0 2px rgba(108, 140, 255, .15);
}

.search-btn {
    background: transparent;
    border: none;
    color: #cbd5e1;
    cursor: pointer;
    font-size: 16px;
}

.top-actions {
    display: flex;
    align-items: center;
    gap: 24px;
}

.top-link {
    color: #f8fafc;
    font-size: 12px;
    font-weight: 500;
    white-space: nowrap;
    opacity: .95;
}

.top-link:hover {
    color: #9db3ff;
}

.premium-btn {
    border: 2px solid #eab308;
    color: #ffd84d;
    border-radius: 16px;
    padding: 7px 14px;
    font-size: 12px;
    font-weight: 800;
    line-height: 1.1;
    text-align: center;
    background: transparent;
}

.badge-reseau {
    background: #ef4444;
    color: white;
    border-radius: 999px;
    padding: 2px 7px;
    font-size: 10px;
    font-weight: 800;
    margin-left: 4px;
}

/* ================= LAYOUT ================= */

.layout {
    display: grid;
    grid-template-columns: 300px 1fr 270px;
    min-height: calc(100vh - 64px);
    background: var(--bg-main);
}

.sidebar-left,
.sidebar-right {
    background: var(--bg-sidebar);
}

.sidebar-left {
    border-right: 1px solid #101b31;
}

.sidebar-right {
    border-left: 4px solid #4f83ff;
}

/* ================= SIDEBAR LEFT ================= */

.side-title {
    padding: 10px 16px 8px;
    color: #ffffff;
    font-size: 14px;
    font-weight: 800;
}

.side-section {
    padding: 0 16px 18px;
}

.side-item {
    margin-bottom: 22px;
}

.side-item strong {
    display: block;
    color: #6c8cff;
    font-size: 13px;
    font-weight: 800;
    margin-bottom: 8px;
}

.activity-empty {
    color: #607089;
    font-size: 12px;
}

.activity-block {
    display: flex;
    flex-direction: column;
    gap: 12px;
}

.activity-card {
    padding-bottom: 12px;
    border-bottom: 1px solid #334155;
}

.activity-card p {
    margin: 2px 0;
    color: #e5e7eb;
    font-size: 12px;
    line-height: 1.35;
}

.activity-title {
    color: #ffffff !important;
    font-weight: 700;
}

.activity-status.ok {
    color: #22c55e;
    font-weight: 700;
}

.activity-status.no {
    color: #ef4444;
    font-weight: 700;
}

.activity-status.wait {
    color: #f59e0b;
    font-weight: 700;
}

/* ================= MAIN ================= */

.main {
    background: #050b18;
    padding: 26px 28px 80px;
}

.profile-shell {
    max-width: 1040px;
    margin: 0 auto;
}

/* ================= COVER ================= */

.cover-box {
    height: 255px;
    width: 100%;
    position: relative;
    overflow: hidden;
    background: linear-gradient(135deg, #0f2744, #1e3a5f);
    background-size: cover;
    background-position: center;
}

.cover-overlay-soft {
    position: absolute;
    inset: 0;
    background: rgba(0, 10, 30, .12);
}

.cover-btn {
    position: absolute;
    right: 24px;
    bottom: 22px;
    z-index: 3;
    color: #ffffff;
    font-size: 13px;
    cursor: pointer;
}

.cover-click-zone {
    position: absolute;
    inset: 0;
    z-index: 2;
    cursor: pointer;
}

/* ================= PROFILE HEADER ================= */

.profile-header {
    display: flex;
    align-items: center;
    gap: 18px;
    padding: 0 0 22px;
    border-bottom: 1px solid #26354f;
}

.avatar-box {
    width: 145px;
    height: 145px;
    border-radius: 50%;
    overflow: hidden;
    position: relative;
    margin-top: -6px;
    flex-shrink: 0;
    cursor: pointer;
    background: #1e293b;
}

.avatar-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.avatar-placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, #4f83ff, #7c5cff);
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-size: 46px;
    font-weight: 800;
}

.avatar-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0,0,0,.48);
    color: #38bdf8;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    opacity: 0;
    transition: .2s ease;
}

.avatar-box:hover .avatar-overlay {
    opacity: 1;
}

.profile-identity {
    padding-top: 4px;
}

.profile-identity h2 {
    margin: 0 0 10px;
    font-size: 14px;
    font-weight: 500;
    color: #ffffff;
}

.meta-line {
    margin: 5px 0;
    color: #ffffff;
    font-size: 13px;
}

.meta-line span {
    color: #ffffff;
}

/* ================= NETWORK ACTIONS ================= */
.network-actions {
    margin-top: 8px;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
}

.connect-btn {
    border: none;
    background: transparent;
    color: #0ea5e9;
    padding: 0;
    font-size: 13px;
    font-weight: 800;
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 2px;
}

.connect-btn:hover {
    color: #38bdf8;
}

.pending-btn {
    border: none;
    background: transparent;
    color: #f59e0b;
    padding: 0;
    font-size: 13px;
    font-weight: 800;
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 2px;
}

.accept-btn {
    border: none;
    background: transparent;
    color: #22c55e;
    padding: 0;
    font-size: 13px;
    font-weight: 800;
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 2px;
}

.refuse-btn,
.remove-btn {
    border: none;
    background: transparent;
    color: #ef4444;
    padding: 0;
    font-size: 13px;
    font-weight: 800;
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 2px;
}

.chat-btn {
    border: none;
    background: transparent;
    color: #0ea5e9;
    padding: 0;
    font-size: 13px;
    font-weight: 800;
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 2px;
}
/* ================= FORM ================= */

.form-block {
    padding-top: 6px;
}

.form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
}

.field {
    display: flex;
    flex-direction: column;
    gap: 6px;
}

.field.full {
    grid-column: 1 / -1;
}

.label {
    color: #cbd5e1;
    font-size: 13px;
    font-weight: 800;
}

.input,
.textarea {
    width: 100%;
    border: 1px solid #334155;
    background: #1b263b;
    color: #ffffff;
    border-radius: 13px;
    padding: 12px 16px;
    outline: none;
    font-size: 13px;
}

.input:focus,
.textarea:focus {
    border-color: #6c8cff;
    box-shadow: 0 0 0 2px rgba(108, 140, 255, .14);
}

.textarea {
    min-height: 72px;
    resize: vertical;
}

/* ================= SKILLS ================= */

.section-block {
    margin-top: 22px;
}

.section-head {
    color: #cbd5e1;
    font-size: 14px;
    font-weight: 800;
    margin-bottom: 12px;
}

.project-card,
.skill-card {
    background: transparent;
    border: none;
    padding: 0;
    margin-bottom: 12px;
}

.project-card p,
.skill-card p {
    margin: 6px 0;
    color: #dbeafe;
    font-size: 13px;
}

.nav-mini {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 22px;
    color: #94a3b8;
    font-size: 13px;
    margin-top: 24px;
}

.mini-arrow {
    background: transparent;
    border: none;
    color: #cbd5e1;
    cursor: pointer;
    font-size: 14px;
}

/* ================= BUTTONS BOTTOM ================= */
.bottom-actions {
    grid-column: 1 / -1;
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 12px;
    width: 100%;
    margin-top: 0;
    margin-bottom: 4px;
    padding-top: 0;
}
.save-btn,
.delete-btn {
    border: none;
    border-radius: 10px;
    padding: 12px 22px;
    font-size: 13px;
    font-weight: 800;
    color: white;
    cursor: pointer;
}

.save-btn {
    background: linear-gradient(135deg, #6c8cff, #7c5cff);
}

.delete-btn {
    background: linear-gradient(135deg, #7c5cff, #8b5cf6);
}

/* ================= FLASH ================= */

.flash {
    border-radius: 12px;
    padding: 12px 14px;
    margin-bottom: 14px;
    font-size: 13px;
}

.flash-success {
    background: rgba(34,197,94,.12);
    border: 1px solid rgba(34,197,94,.35);
    color: #4ade80;
}

.flash-error {
    background: rgba(239,68,68,.12);
    border: 1px solid rgba(239,68,68,.35);
    color: #f87171;
}

/* ================= SIDEBAR RIGHT CONTACTS ================= */

.contacts-list {
    padding: 8px 12px 12px;
}

.contact-row {
    width: 100%;
    border: none;
    background: transparent;
    text-align: left;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 6px 4px;
    border-radius: 10px;
    transition: .15s ease;
    position: relative;
}

.contact-row:hover {
    background: rgba(255,255,255,.05);
}

.contact-avatar {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    object-fit: cover;
    background: #243252;
    flex-shrink: 0;
}

.avatar-mini-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #4f83ff, #7c5cff);
    color: white;
    font-weight: 800;
}

.contact-name {
    color: #ffffff;
    font-size: 13px;
    font-weight: 700;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.msg-badge {
    margin-left: auto;
    background: #3b82f6;
    color: white;
    border-radius: 999px;
    padding: 2px 7px;
    font-size: 10px;
    font-weight: 800;
}

.contact-row.has-online::after {
    content: "";
    width: 8px;
    height: 8px;
    background: #22c55e;
    border-radius: 50%;
    border: 2px solid #081226;
    position: absolute;
    left: 33px;
    bottom: 7px;
}

/* ================= INVITATIONS ================= */

.invitations-box {
    border-top: 1px solid #122343;
    padding-top: 8px;
    margin-top: 10px;
}

.invitation-card {
    background: #111b31;
    border: 1px solid #26354f;
    border-radius: 12px;
    padding: 10px;
    margin: 8px 12px;
}

.invitation-card strong {
    display: block;
    color: #ffffff;
    font-size: 13px;
}

.invitation-card small {
    display: block;
    color: #94a3b8;
    font-size: 11px;
    margin-top: 3px;
}

.invitation-actions {
    display: flex;
    gap: 6px;
    margin-top: 8px;
}

.empty {
    color: #64748b;
    font-size: 12px;
}

/* ================= MINI CHAT POPUP ================= */

.mini-chat {
    position: fixed;
    right: 16px;
    bottom: 0;
    width: 355px;
    height: 510px;
    background: #17152b;
    border: 1px solid #2d294d;
    box-shadow: 0 18px 45px rgba(0,0,0,.55);
    z-index: 9999;
    display: none;
    overflow: hidden;
}

.mini-chat.is-open {
    display: flex;
    flex-direction: column;
}

.mini-chat-header {
    height: 62px;
    background: #18162f;
    border-bottom: 1px solid #2d294d;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 0 12px;
}

.mini-chat-avatar-wrap {
    position: relative;
    width: 38px;
    height: 38px;
    flex-shrink: 0;
}

.mini-chat-avatar {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    object-fit: cover;
    background: #2d2a4d;
}

.mini-chat-avatar-placeholder {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: linear-gradient(135deg, #4f83ff, #7c5cff);
    color: white;
    display: none;
    align-items: center;
    justify-content: center;
    font-weight: 800;
}

.mini-chat-avatar-wrap::after {
    content: "";
    width: 8px;
    height: 8px;
    background: #22c55e;
    border: 2px solid #18162f;
    border-radius: 50%;
    position: absolute;
    right: 0;
    bottom: 1px;
}

.mini-chat-info {
    min-width: 0;
    flex: 1;
}

.mini-chat-name {
    color: #ffffff;
    font-size: 14px;
    font-weight: 800;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.mini-chat-status {
    color: #22c55e;
    font-size: 11px;
    margin-top: 2px;
}

.mini-chat-actions {
    display: flex;
    align-items: center;
    gap: 6px;
}
.skill-form-block {
    margin-top: 22px;
}

.skill-form-block .input,
.skill-form-block .textarea {
    background: #1b263b;
    border: 1px solid #334155;
    color: #ffffff;
}

.skill-form-block .input[readonly],
.skill-form-block .textarea[readonly] {
    cursor: default;
}

.skill-description {
    min-height: 70px;
}

.skill-nav {
    margin-top: 22px;
    margin-bottom: 26px;
}
.mini-chat-icon,
.mini-chat-close,
.mini-chat-min {
    width: 28px;
    height: 28px;
    border: none;
    border-radius: 50%;
    background: #2b2947;
    color: #d8d5ff;
    cursor: pointer;
    font-size: 13px;
    display: flex;
    align-items: center;
    justify-content: center;
}
/* ================= RESEAUX MODAL ================= */

.reseau-open-btn {
    border: none;
    background: transparent;
    cursor: pointer;
    font-family: inherit;
}

.reseau-modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, .25);
    z-index: 9998;
    display: none;
}

.reseau-modal-overlay.is-open {
    display: block;
}

.reseau-modal {
    position: fixed;
    top: 55px;
    left: 50%;
    transform: translateX(-50%);
    width: 560px;
    min-height: 420px;
    max-height: 520px;
    background: #0b1324;
    border: 1px solid #334155;
    border-radius: 10px;
    box-shadow: 0 22px 60px rgba(0, 0, 0, .65);
    z-index: 9999;
    display: none;
    overflow: hidden;
}

.reseau-modal.is-open {
    display: flex;
    flex-direction: column;
}

.reseau-modal-titlebar {
    height: 38px;
    background: #f3f4f6;
    color: #111827;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 12px;
    font-size: 13px;
    font-weight: 600;
}

.reseau-modal-title-left {
    display: flex;
    align-items: center;
    gap: 7px;
}

.reseau-window-icon {
    width: 14px;
    height: 14px;
    border: 1px solid #94a3b8;
    background: linear-gradient(135deg, #dbeafe, #ffffff);
}

.reseau-window-actions {
    display: flex;
    align-items: center;
    gap: 12px;
}

.reseau-window-btn {
    border: none;
    background: transparent;
    color: #111827;
    font-size: 18px;
    line-height: 1;
    cursor: pointer;
    width: 22px;
    height: 22px;
}

.reseau-window-btn:hover {
    background: rgba(0, 0, 0, .08);
}

.reseau-modal-body {
    flex: 1;
    padding: 22px 24px;
    background: #0b1324;
    overflow-y: auto;
}

.reseau-invitation-card {
    width: 100%;
    background: #1b263b;
    border: 1px solid #25344d;
    border-radius: 9px;
    padding: 13px 16px;
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 12px;
}

.reseau-avatar {
    width: 43px;
    height: 43px;
    border-radius: 50%;
    object-fit: cover;
    background: #334155;
    flex-shrink: 0;
}

.reseau-avatar-placeholder {
    width: 43px;
    height: 43px;
    border-radius: 50%;
    background: linear-gradient(135deg, #4f83ff, #7c5cff);
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-weight: 800;
    flex-shrink: 0;
}

.reseau-info {
    min-width: 0;
    flex: 1;
}
.contact-row {
    width: 100%;
    border: none;
    background: transparent;
    text-align: left;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 6px 4px;
    border-radius: 10px;
    transition: .15s ease;
    position: relative;
    user-select: none;
}

.contact-row:hover {
    background: rgba(255,255,255,.07);
}

.contact-row:focus {
    outline: 1px solid #6c8cff;
    background: rgba(255,255,255,.06);
}

.contact-avatar,
.contact-name {
    pointer-events: none;
}


.reseau-name {
    color: #ffffff;
    font-size: 14px;
    font-weight: 800;
    margin-bottom: 4px;
}

.reseau-email {
    color: #94a3b8;
    font-size: 12px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.reseau-actions {
    display: flex;
    align-items: center;
    gap: 10px;
}

.reseau-accept-btn,
.reseau-refuse-btn {
    border: none;
    border-radius: 7px;
    padding: 9px 16px;
    color: white;
    font-size: 13px;
    font-weight: 800;
    cursor: pointer;
}

.reseau-accept-btn {
    background: #22c55e;
}

.reseau-accept-btn:hover {
    background: #16a34a;
}

.reseau-refuse-btn {
    background: #ef4444;
}

.reseau-refuse-btn:hover {
    background: #dc2626;
}

.reseau-empty {
