<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SkillSwap — Vos Compétences</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
   <style>
    *, *::before, *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    :root {
        --bg: #070d18;
        --top: #0d1422;
        --panel: #0d1422;
        --panel2: #0b1220;
        --line: #263449;
        --line2: #334155;
        --thead: #182231;
        --text: #f8fafc;
        --muted: #64748b;
        --input: #172131;
        --input-border: #334155;
        --purple: #6d5dfc;
        --purple-hover: #8277ff;
        --blue-btn: #334f8f;
        --blue-btn-2: #384b6a;
        --danger: #4b5563;
    }

    html,
    body {
        background: var(--bg);
        color: var(--text);
        font-family: 'Inter', Arial, sans-serif;
        min-height: 100vh;
        overflow-x: hidden;
    }

    a {
        text-decoration: none;
        color: inherit;
    }

    /* TOPBAR */
    .topbar {
        height: 58px;
        background: var(--top);
        border-bottom: 1px solid #1e293b;
        display: flex;
        align-items: center;
        padding: 0 24px;
        gap: 16px;
    }

    .brand {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .brand img {
        width: 34px;
        height: 34px;
        object-fit: contain;
    }

    .brand span {
        color: #ffffff;
        font-size: 18px;
        font-weight: 800;
    }

    .spacer {
        flex: 1;
    }

    .top-nav {
        display: flex;
        align-items: center;
        gap: 35px;
    }

    .nav-link {
        font-size: 12px;
        color: #ffffff;
        font-weight: 700;
        opacity: 1;
    }

    .nav-link:hover {
        color: #c7d2fe;
    }

    /* PAGE */
    .page {
        max-width: 1650px;
        width: 92%;
        margin: 0 auto;
        padding: 30px 0 40px;
    }

    .page-title {
        font-size: 34px;
        font-weight: 900;
        letter-spacing: -0.5px;
        color: #ffffff;
        margin-bottom: 22px;
    }

    .layout {
        display: grid;
        grid-template-columns: minmax(0, 1.15fr) minmax(0, 360px);
        gap: 20px;
        align-items: start;
    }

    /* CARD */
    .card {
        background: var(--panel);
        border: 1px solid var(--line);
        border-radius: 10px;
        padding: 16px;
        min-width: 0;
        overflow: hidden;
        box-shadow: 0 12px 35px rgba(0, 0, 0, 0.25);
    }

    .card-title {
        font-size: 20px;
        font-weight: 900;
        color: #ffffff;
        margin-bottom: 12px;
    }

    /* FLASH */
    .flash {
        border-radius: 8px;
        padding: 12px 14px;
        margin-bottom: 16px;
        font-size: 13px;
        font-weight: 700;
    }

    .flash.success {
        background: rgba(34, 197, 94, 0.15);
        border: 1px solid rgba(34, 197, 94, 0.35);
        color: #86efac;
    }

    .flash.error {
        background: rgba(239, 68, 68, 0.15);
        border: 1px solid rgba(239, 68, 68, 0.35);
        color: #fca5a5;
    }

    /* TABLE */
    .table-wrap {
        width: 100%;
        height: 420px;
        max-width: 100%;
        overflow-x: auto;
        overflow-y: auto;
        border-radius: 8px;
        border: 1px solid #253449;
        background: var(--panel2);
        min-height: 0;
    }

    table {
        width: 100%;
        min-width: 900px;
        border-collapse: collapse;
        table-layout: fixed;
        font-size: 12px;
        color: #ffffff;
    }

    thead {
        background: var(--thead);
        position: sticky;
        top: 0;
        z-index: 5;
    }

    thead tr {
        background: var(--thead);
    }

    thead th {
        padding: 13px 10px;
        text-align: center;
        font-size: 11px;
        font-weight: 900;
        color: #ffffff;
        border-bottom: 1px solid var(--line);
        border-right: 1px solid #263449;
        white-space: nowrap;
    }

    tbody tr {
        border-bottom: 1px solid #182638;
        cursor: pointer;
        background: #0d1422;
        transition: background 0.2s ease;
    }

    tbody tr:hover {
        background: #111c2f;
    }

    tbody tr.selected {
        background: rgba(99, 102, 241, 0.32);
    }

    tbody td {
        padding: 13px 10px;
        text-align: center;
        border-right: 1px solid #182638;
        color: #f8fafc;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    thead th:last-child,
    tbody td:last-child {
        border-right: none;
    }

    .empty-state {
        text-align: center;
        padding: 40px;
        color: var(--muted);
        font-style: normal;
    }

    /* BADGES */
    .badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 4px 10px;
        border-radius: 999px;
        font-size: 11px;
        font-weight: 800;
        border: 1px solid transparent;
        min-width: 78px;
    }

    .badge-valid {
        color: #86efac;
        background: rgba(34, 197, 94, 0.15);
        border-color: rgba(34, 197, 94, 0.35);
    }

    .badge-cours {
        color: #93c5fd;
        background: rgba(59, 130, 246, 0.15);
        border-color: rgba(59, 130, 246, 0.35);
    }

    .badge-expire {
        color: #fca5a5;
        background: rgba(239, 68, 68, 0.15);
        border-color: rgba(239, 68, 68, 0.35);
    }

    /* FORM */
    .field-group {
        margin-bottom: 12px;
    }

    .field-label {
        display: block;
        font-size: 12px;
        font-weight: 800;
        color: #ffffff;
        margin-bottom: 6px;
    }

    .input,
    .select,
    .textarea {
        width: 100%;
        background: var(--input);
        border: 1px solid var(--input-border);
        color: #ffffff;
        border-radius: 9px;
        padding: 10px 12px;
        outline: none;
        font-size: 12px;
    }

    .textarea {
        resize: vertical;
        min-height: 72px;
    }

    .input:focus,
    .select:focus,
    .textarea:focus {
        border-color: var(--purple);
        box-shadow: 0 0 0 2px rgba(99, 102, 241, 0.18);
    }

    .hint {
        display: block;
        margin-top: 8px;
        min-height: 18px;
        color: #fca5a5;
        font-size: 12px;
        font-weight: 700;
    }

    /* BUTTONS */
    .btn-row,
    .action-row {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        margin-top: 14px;
    }

    .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: none;
        border-radius: 8px;
        min-width: 92px;
        height: 36px;
        padding: 0 14px;
        font-size: 12px;
        font-weight: 800;
        cursor: pointer;
        color: #ffffff;
        text-decoration: none;
    }

    .btn:hover {
        opacity: 0.92;
    }

    .btn-primary,
    .btn-warning,
    .btn-ghost,
    .btn-teal {
        background: var(--blue-btn);
    }

    .btn-danger {
        background: var(--danger);
    }

    .btn-icon-danger {
        background: transparent;
        border: none;
        color: #fca5a5;
        cursor: pointer;
        font-size: 15px;
        font-weight: 900;
    }

    .btn-icon-danger:hover {
        color: #ef4444;
    }

    /* ASSISTANT BUTTON */
    .assistant-launch-wrap {
        margin-top: 14px;
    }

    .assistant-launch-btn {
        width: 100%;
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        border: 1px solid #334155;
        background: #172131;
        color: #ffffff;
        border-radius: 9px;
        padding: 12px 16px;
        font-size: 13px;
        font-weight: 800;
        cursor: pointer;
        transition: 0.2s ease;
    }

    .assistant-launch-btn:hover {
        border-color: var(--purple);
        box-shadow: 0 0 0 2px rgba(99, 102, 241, 0.18);
    }

    .assistant-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 22px;
        height: 22px;
        padding: 0 6px;
        border-radius: 999px;
        background: #ff3b4d;
        color: #ffffff;
        font-size: 12px;
        font-weight: 800;
        line-height: 1;
        box-shadow: 0 0 0 3px rgba(255, 255, 255, 0.04);
    }

    .assistant-badge.hidden {
        display: none;
    }

    /* ASSISTANT WINDOW */
    .assistant-window {
        position: fixed;
        right: 26px;
        bottom: 26px;
        width: 360px;
        height: 500px;
        background: #0d1422;
        border: 1px solid #263449;
        border-radius: 10px;
        box-shadow: 0 20px 45px rgba(0, 0, 0, 0.35);
        display: none;
        flex-direction: column;
        z-index: 9999;
        overflow: hidden;
    }

    .assistant-window.open {
        display: flex;
    }

    .assistant-window-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 14px 16px;
        border-bottom: 1px solid #263449;
        background: #0d1422;
        color: #ffffff;
    }

    .assistant-window-subtitle {
        font-size: 12px;
        color: #64748b;
        margin-top: 2px;
    }

    .assistant-window-actions {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .assistant-minimize,
    .assistant-close {
        background: transparent;
        border: none;
        color: #ffffff;
        font-size: 18px;
        line-height: 1;
        cursor: pointer;
        width: 28px;
        height: 28px;
        border-radius: 8px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: 0.2s ease;
    }

    .assistant-minimize:hover,
    .assistant-close:hover {
        background: rgba(255, 255, 255, 0.08);
    }

    .assistant-window.minimized {
        height: auto;
    }

    .assistant-window.minimized .assistant-window-messages,
    .assistant-window.minimized .assistant-window-input {
        display: none;
    }

    .assistant-window-messages {
        flex: 1;
        overflow-y: auto;
        padding: 14px;
        display: flex;
        flex-direction: column;
        gap: 10px;
        background: #0b1220;
    }

    .assistant-window-input {
        display: flex;
        gap: 8px;
        padding: 12px;
        border-top: 1px solid #263449;
        background: #0d1422;
    }

    .assistant-window-input input {
        flex: 1;
        background: #172131;
        border: 1px solid #334155;
        color: #ffffff;
        border-radius: 9px;
        padding: 10px 12px;
        outline: none;
        font-size: 13px;
    }

    .assistant-window-input input:focus {
        border-color: var(--purple);
        box-shadow: 0 0 0 2px rgba(99, 102, 241, 0.18);
    }

    .chat-msg-row {
        display: flex;
    }

    .chat-msg-row.user {
        justify-content: flex-end;
    }

    .chat-msg-row.bot {
        justify-content: flex-start;
    }

    .chat-bubble {
        max-width: 80%;
        padding: 10px 12px;
        border-radius: 12px;
        line-height: 1.5;
        font-size: 13px;
        white-space: pre-wrap;
        word-break: break-word;
    }

    .chat-bubble.user {
        background: #334f8f;
        color: #ffffff;
        border-bottom-right-radius: 4px;
    }

    .chat-bubble.bot {
        background: #172131;
        color: #d9e4ff;
        border: 1px solid #334155;
        border-bottom-left-radius: 4px;
    }

    .chat-typing {
        font-style: italic;
        color: #64748b;
    }

    /* CALENDAR */
    #calendarModal {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.45);
        display: none;
        align-items: center;
        justify-content: center;
        z-index: 1000;
    }

    .modal-card {
        width: 420px;
        background: #0d1422;
        border: 1px solid #263449;
        border-radius: 10px;
        padding: 18px;
        color: #ffffff;
    }

    .cal-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 14px;
    }

    .cal-title {
        font-size: 20px;
        font-weight: 900;
    }

    .cal-grid {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        gap: 8px;
    }

    .dow,
    .day {
        display: flex;
        align-items: center;
        justify-content: center;
        height: 38px;
        border-radius: 8px;
    }

    .dow {
        font-size: 12px;
        color: #64748b;
        font-weight: 800;
    }

    .day {
        background: #172131;
        border: 1px solid #334155;
        cursor: pointer;
    }

    .day:hover {
        border-color: var(--purple);
    }

    .day.today {
        outline: 2px solid #334f8f;
    }

    .day.selected {
        background: var(--purple);
        color: #ffffff;
    }

    /* SCROLLBARS */
    .table-wrap::-webkit-scrollbar,
    .assistant-window-messages::-webkit-scrollbar {
        height: 8px;
        width: 8px;
    }

    .table-wrap::-webkit-scrollbar-track,
    .assistant-window-messages::-webkit-scrollbar-track {
        background: #111827;
        border-radius: 20px;
    }

    .table-wrap::-webkit-scrollbar-thumb,
    .assistant-window-messages::-webkit-scrollbar-thumb {
        background: var(--purple);
        border-radius: 20px;
    }

    .table-wrap::-webkit-scrollbar-thumb:hover,
    .assistant-window-messages::-webkit-scrollbar-thumb:hover {
        background: var(--purple-hover);
    }

    @media (max-width: 1180px) {
        .page {
            width: 95%;
        }

        .layout {
            grid-template-columns: 1fr;
        }
    }

    @media (max-width: 600px) {
        .page-title {
            font-size: 28px;
        }

        .top-nav {
            gap: 16px;
        }

        .assistant-window {
            right: 12px;
            left: 12px;
            bottom: 12px;
            width: auto;
        }

        .modal-card {
            width: calc(100% - 24px);
        }
    }
</style>
</head>
<body>
<header class="topbar">
    <a href="#" class="brand">
        <img src="{{ asset('image/competences/logo.png') }}" alt="SkillSwap">
        <span>SkillSwap</span>
    </a>
    <div class="spacer"></div>
    <nav class="top-nav">
        <a href="{{ path('app_accueil') }}" class="nav-link">Accueil</a>
        <a href="{{ path('app_profil') }}" class="nav-link">Profil</a>
        <a href="#" class="nav-link">Offres</a>
    </nav>
</header>

<main class="page">
    <h1 class="page-title">Vos Compétences</h1>

    {% for msg in app.flashes('success') %}
        <div class="flash success">✓ {{ msg }}</div>
    {% endfor %}
    {% for msg in app.flashes('error') %}
        <div class="flash error">✗ {{ msg }}</div>
    {% endfor %}

    <div class="layout">
        <div class="card">
            <div class="table-wrap">
                <table id="comp-table">
                    <thead>
                    <tr>
                        <th>ID</th>
                        <th>Email</th>
                        <th>Niveau</th>
                        <th>Type</th>
                        <th>Catégorie</th>
                        <th>Certification</th>
                        <th>Expérience</th>
                        <th>Statut</th>
                        <th>Action</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for i, comp in competences %}
                        <tr
                            data-id="{{ comp.id }}"
                            data-type="{{ comp.type }}"
                            data-category="{{ comp.category }}"
                            data-description="{{ comp.description }}"
                            data-niveau="{{ comp.niveau }}"
                            data-annees="{{ comp.anneesExperience }}"
                            data-certification="{{ comp.certification }}"
                            data-statut="{{ comp.statut }}"
                            onclick="selectRow(this)"
                        >
                            <td>{{ i + 1 }}</td>
                            <td>{{ comp.email }}</td>
                            <td>{{ comp.niveau }}</td>
                            <td>{{ comp.type }}</td>
                            <td>{{ comp.category }}</td>
                            <td>{{ comp.certification ?: '—' }}</td>
                            <td>{{ comp.anneesExperience }}</td>
                            <td>
                                {% if comp.statut == 'Validée' %}
                                    <span class="badge badge-valid">Validée</span>
                                {% elseif comp.statut == 'En cours' %}
                                    <span class="badge badge-cours">En cours</span>
                                {% else %}
                                    <span class="badge badge-expire">Expirée</span>
                                {% endif %}
                            </td>
                            <td>
                                <form method="post" action="{{ path('competence_front_delete', {id: comp.id}) }}" onsubmit="return confirm('Supprimer cette compétence ?');">
                                    <button type="submit" class="btn-icon-danger">✕</button>
                                </form>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="9" class="empty-state">Aucune compétence enregistrée.</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>

       
        </div>

       <div class="card">
    <div class="card-title" id="form-title">
        {{ editing ? 'Modifier votre compétence' : 'Ajouter votre compétence' }}
    </div>

    {{ form_start(form, {
        'attr': {'id': 'competenceForm'},
        'action': editing ? path('competence_front_edit', {'id': editing.id}) : path('competence_front_index'),
        'method': 'POST'
    }) }}

    <div class="field-group">
        <label class="field-label">Type</label>
        {{ form_widget(form.type, {attr: {class: 'input', placeholder: 'Ex: Java'}}) }}
    </div>

    <div class="field-group">
        <label class="field-label">Catégorie</label>
        {{ form_widget(form.category, {attr: {class: 'input', placeholder: 'Ex: IT'}}) }}
    </div>

    <div class="field-group">
        <label class="field-label">Description</label>
        {{ form_widget(form.description, {attr: {class: 'textarea', placeholder: 'Description...', rows: 3}}) }}
    </div>

    <div class="field-group">
        <label class="field-label">Niveau</label>
        {{ form_widget(form.niveau, {attr: {class: 'select'}}) }}
    </div>

    <div class="field-group">
        <label class="field-label">Années d'expérience</label>
        {{ form_widget(form.anneesExperience, {attr: {class: 'input', min: 0, max: 60}}) }}
    </div>

    <div class="field-group">
        <label class="field-label">Certification</label>
        {{ form_widget(form.certification, {attr: {class: 'input', placeholder: 'Ex: Oracle, AWS...'}}) }}
    </div>

    {% if error %}
        <span class="hint">{{ error }}</span>
    {% endif %}

    <div class="btn-row">
        <button type="submit" class="btn btn-primary">
            {{ editing ? 'Modifier' : 'Ajouter' }}
        </button>
        <button type="button" class="btn btn-warning" onclick="submitEdit()">Modifier</button>
        <button type="button" class="btn btn-danger" onclick="submitDelete()">Supprimer</button>
        <button type="button" class="btn btn-ghost" onclick="resetForm()">Réinitialiser</button>
    </div>
   <div class="assistant-launch-wrap">
    <button type="button" class="assistant-launch-btn" onclick="toggleAssistantWindow()" id="assistantLaunchBtn">
        <span>💬 Assistant SkillSwap</span>
        <span class="assistant-badge" id="assistantBadge">1</span>
    </button>
</div>

    {{ form_end(form) }}
</div><div id="assistantWindow" class="assistant-window">
    <div class="assistant-window-header">
        <div>
            <strong>Assistant SkillSwap</strong>
            <div class="assistant-window-subtitle">Idées pour votre profil</div>
        </div>

        <div class="assistant-window-actions">
            <button type="button" class="assistant-minimize" onclick="toggleAssistantMinimize()">—</button>
            <button type="button" class="assistant-close" onclick="closeAssistantWindow()">✕</button>
        </div>
    </div>

    <div class="assistant-window-messages" id="chatMessages"></div>

    <div class="assistant-window-input">
        <input type="text" id="chatInput" placeholder="Ex: donne-moi une idée">
        <button type="button" class="btn btn-ghost" onclick="sendChatMessage()">Envoyer</button>
    </div>
</div>
</main>

<div id="calendarModal">
    <div class="modal-card">
        <div class="cal-header">
            <button class="btn btn-ghost" type="button" onclick="changeMonth(-1)">◀</button>
            <div class="cal-title" id="calTitle"></div>
            <button class="btn btn-ghost" type="button" onclick="changeMonth(1)">▶</button>
        </div>
        <div class="cal-grid" id="calendarGrid"></div>
        <div class="btn-row" style="justify-content:flex-end;margin-top:14px;">
            <button class="btn btn-ghost" type="button" onclick="closeCalendar()">Fermer</button>
        </div>
    </div>
</div>
<script>
let selectedId = {{ editing ? editing.id : 'null' }};
let assistantIntroLoaded = false;

function selectRow(tr) {
    document.querySelectorAll('#comp-table tbody tr').forEach(r => r.classList.remove('selected'));
    tr.classList.add('selected');

    selectedId = tr.dataset.id;

    document.getElementById('competenceForm').querySelector('[id$="_type"]').value = tr.dataset.type || '';
    document.getElementById('competenceForm').querySelector('[id$="_category"]').value = tr.dataset.category || '';
    document.getElementById('competenceForm').querySelector('[id$="_description"]').value = tr.dataset.description || '';
    document.getElementById('competenceForm').querySelector('[id$="_niveau"]').value = tr.dataset.niveau || 'Débutant';
    document.getElementById('competenceForm').querySelector('[id$="_anneesExperience"]').value = tr.dataset.annees || '0';
    document.getElementById('competenceForm').querySelector('[id$="_certification"]').value = tr.dataset.certification || '';
}

function submitEdit() {
    if (!selectedId) {
        alert('Sélectionne une ligne.');
        return;
    }
    const form = document.getElementById('competenceForm');
    form.action = '/front/competences/edit/' + selectedId;
    form.submit();
}

function submitDelete() {
    if (!selectedId) {
        alert('Sélectionne une ligne.');
        return;
    }
    if (!confirm('Supprimer cette compétence ?')) return;

    const form = document.createElement('form');
    form.method = 'post';
    form.action = '/front/competences/delete/' + selectedId;
    document.body.appendChild(form);
    form.submit();
}

function resetForm() {
    selectedId = null;
    document.querySelectorAll('#comp-table tbody tr').forEach(r => r.classList.remove('selected'));
    document.getElementById('competenceForm').reset();

    const niveau = document.getElementById('competenceForm').querySelector('[id$="_niveau"]');
    const annees = document.getElementById('competenceForm').querySelector('[id$="_anneesExperience"]');

    if (niveau) niveau.value = 'Débutant';
    if (annees) annees.value = '0';
}
function escapeHtml(text) {
    const div = document.createElement('div');
    div.textContent = text ?? '';
    return div.innerHTML;
}

function formatAssistantMessage(text) {
    const safe = escapeHtml(text);

    return safe.replace(
        /(\/front\/competences\/cv\/pdf)/g,
        '<a href="$1" target="_blank" style="color:#8ab4ff;text-decoration:underline;">Télécharger le CV PDF</a>'
    );
}

function addChatMessage(role, text) {
    const box = document.getElementById('chatMessages');
    const row = document.createElement('div');
    row.className = 'chat-msg-row ' + role;

    const bubble = document.createElement('div');
    bubble.className = 'chat-bubble ' + role;

    if (role === 'bot') {
        bubble.innerHTML = formatAssistantMessage(text);
    } else {
        bubble.textContent = text;
    }

    row.appendChild(bubble);
    box.appendChild(row);
    box.scrollTop = box.scrollHeight;
}

function addChatUserMessage(text) {
    addChatMessage('user', text);
}

function addChatBotMessage(text) {
    addChatMessage('bot', text);
}

function addChatTyping() {
    const box = document.getElementById('chatMessages');
    const row = document.createElement('div');
    row.className = 'chat-msg-row bot';
    row.id = 'chatTypingRow';

    const bubble = document.createElement('div');
    bubble.className = 'chat-bubble bot chat-typing';
    bubble.textContent = "Je réfléchis...";

    row.appendChild(bubble);
    box.appendChild(row);
    box.scrollTop = box.scrollHeight;
}

function removeChatTyping() {
    const el = document.getElementById('chatTypingRow');
    if (el) el.remove();
}

async function loadAssistantIntro() {
    if (assistantIntroLoaded) return;

    addChatBotMessage("Bonjour, comment ça va ? J’ai quelques idées pour votre profil. Si vous voulez ☺️");
    assistantIntroLoaded = true;

    const badge = document.getElementById('assistantBadge');
    if (badge) badge.classList.add('hidden');
}

async function sendChatMessage() {
    const input = document.getElementById('chatInput');
    const text = input.value.trim();
    if (!text) return;

    input.value = '';
    addChatUserMessage(text);
    addChatTyping();

    try {
        const response = await fetch('{{ path("competence_front_chatbot_send") }}', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({ message: text })
        });

        const data = await response.json();
        removeChatTyping();

        if (!response.ok) {
            addChatBotMessage(data.reply || "Je n’ai pas compris. Réessayez.");
            return;
        }

        addChatBotMessage(data.reply || "Je n’ai pas de réponse pour le moment.");
    } catch (e) {
        removeChatTyping();
        addChatBotMessage("Erreur de connexion avec le serveur.");
    }
}

function toggleAssistantWindow() {
    const win = document.getElementById('assistantWindow');
    if (!win) return;

    const isOpening = !win.classList.contains('open');

    if (isOpening) {
        win.classList.add('open');
        win.classList.remove('minimized');

        const chatMessages = document.getElementById('chatMessages');
        if (chatMessages && chatMessages.innerHTML.trim() === '') {
            loadAssistantIntro();
        }
        return;
    }

    win.classList.remove('open');
    win.classList.remove('minimized');
}

function closeAssistantWindow() {
    const win = document.getElementById('assistantWindow');
    if (!win) return;

    win.classList.remove('open');
    win.classList.remove('minimized');
}

function toggleAssistantMinimize() {
    const win = document.getElementById('assistantWindow');
    if (!win || !win.classList.contains('open')) return;

    win.classList.toggle('minimized');
}

document.addEventListener('DOMContentLoaded', function () {
    const chatInput = document.getElementById('chatInput');
    if (chatInput) {
        chatInput.addEventListener('keydown', function (e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                sendChatMessage();
            }
        });
    }
});
</script>

</body>
</html>