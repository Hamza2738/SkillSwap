{# templates/Competences/back/competence.html.twig #}
{% extends 'base.html.twig' %}
{% block title %}Compétences · SkillSwap{% endblock %}

{% block stylesheets %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
<style>
*, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

:root {
    --bg: #020b1d;
    --top: #081225;
    --panel: #081328;
    --panel-2: #0c1830;
    --line: #203152;
    --line-soft: #1a2842;
    --text: #f6f8ff;
    --muted: #8fa3c7;
    --input: #1a2742;
    --input-border: #31476e;
    --purple: #7d74ff;
    --purple-2: #6aa2ff;
    --danger: #ff6b81;
    --warning: #f4c542;
    --success: #2fbf8f;
}
.assistant-launch-wrap {
    margin-top: 14px;
}

.assistant-launch-btn {
    width: 100%;
    border: 1px solid #2f4773;
    background: linear-gradient(135deg, #132342, #1a2d54);
    color: #eef4ff;
    border-radius: 16px;
    padding: 12px 16px;
    font-size: 14px;
    font-weight: 700;
    cursor: pointer;
    transition: .2s ease;
}
.dashboard-modal {
    position: fixed;
    inset: 0;
    background: rgba(2, 8, 24, .58);
    display: none;
    align-items: center;
    justify-content: center;
    z-index: 10000;
    padding: 20px;
}

.dashboard-modal.open {
    display: flex;
}

.dashboard-box {
    width: min(720px, 100%);
    background: #03122b;
    border: 1px solid #1f365e;
    border-radius: 24px;
    box-shadow: 0 26px 60px rgba(0,0,0,.45);
    overflow: hidden;
}

.dashboard-modal-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 12px;
    padding: 18px 20px 10px;
}

.dashboard-modal-title {
    font-size: 19px;
    font-weight: 800;
    color: #ffffff;
}

.dashboard-modal-subtitle {
    font-size: 14px;
    color: #d7e5ff;
    margin-top: 4px;
}

.dashboard-close {
    background: transparent;
    border: none;
    color: #ffffff;
    font-size: 22px;
    cursor: pointer;
    width: 34px;
    height: 34px;
    border-radius: 10px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
}

.dashboard-close:hover {
    background: rgba(255,255,255,.08);
}

.dashboard-modal-body {
    padding: 4px 20px 14px;
}

.dashboard-chart-wrap {
    position: relative;
    width: 100%;
    height: 420px;
    background: transparent;
}

.dashboard-modal-footer {
    display: flex;
    justify-content: flex-end;
    padding: 0 20px 18px;
}
.assistant-launch-btn:hover {
    transform: translateY(-1px);
    border-color: #5f82d1;
    background: linear-gradient(135deg, #17305b, #213b6c);
}

.assistant-window {
    position: fixed;
    right: 26px;
    bottom: 26px;
    width: 360px;
    height: 500px;
    background: #0a152d;
    border: 1px solid #233555;
    border-radius: 18px;
    box-shadow: 0 20px 45px rgba(0,0,0,.35);
    display: none;
    flex-direction: column;
    z-index: 9999;
    overflow: hidden;
}

.assistant-window.open {
    display: flex;
}

.assistant-window-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 14px 16px;
    border-bottom: 1px solid #223454;
    background: #0c1830;
}

.assistant-window-subtitle {
    font-size: 12px;
    color: #8fa3c7;
    margin-top: 2px;
}

.assistant-close {
    background: transparent;
    border: none;
    color: white;
    font-size: 18px;
    cursor: pointer;
}

.assistant-window-messages {
    flex: 1;
    overflow-y: auto;
    padding: 14px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    background: #091223;
}

.assistant-window-input {
    display: flex;
    gap: 8px;
    padding: 12px;
    border-top: 1px solid #223454;
    background: #0c1830;
}

.assistant-window-input input {
    flex: 1;
    background: #16233d;
    border: 1px solid #31476e;
    color: white;
    border-radius: 10px;
    padding: 10px 12px;
    outline: none;
    font-size: 13px;
}

.assistant-window-input input:focus {
    border-color: #7d74ff;
    box-shadow: 0 0 0 3px rgba(125,116,255,.16);
}
html, body {
    background: var(--bg);
    color: var(--text);
    font-family: 'Inter', sans-serif;
    min-height: 100vh;
    overflow-x: hidden;
}

.chat-msg-row {
    display: flex;
}

.chat-msg-row.user {
    justify-content: flex-end;
}

.chat-msg-row.bot {
    justify-content: flex-start;
}

.chat-bubble {
    max-width: 80%;
    padding: 10px 12px;
    border-radius: 12px;
    line-height: 1.5;
    font-size: 13px;
    white-space: pre-wrap;
    word-break: break-word;
}

.chat-bubble.user {
    background: #21406a;
    color: #e8f1ff;
    border-bottom-right-radius: 4px;
}

.chat-bubble.bot {
    background: #13203a;
    color: #d9e4ff;
    border: 1px solid #24375a;
    border-bottom-left-radius: 4px;
}



.chat-typing {
    font-style: italic;
    color: #8fa3c7;
}
a {
    text-decoration: none;
    color: inherit;
}

.topbar {
    height: 64px;
    background: var(--top);
    border-bottom: 1px solid #112241;
    display: flex;
    align-items: center;
    padding: 0 26px;
    gap: 16px;
}

.brand {
    display: flex;
    align-items: center;
    gap: 12px;
}

.brand img {
    width: 40px;
    height: 40px;
    object-fit: contain;
}

.brand span {
    color: #ffffff;
    font-size: 15px;
    font-weight: 700;
}

.topbar-spacer {
    flex: 1;
}

.nav-link {
    font-size: 13px;
    color: #f5f7ff;
    opacity: .9;
    padding: 8px 10px;
    border-radius: 10px;
    transition: .2s ease;
}

.nav-link:hover {
    background: rgba(255,255,255,.05);
    opacity: 1;
}

.page {
    max-width: 1280px;
    margin: 0 auto;
    padding: 26px 18px 40px;
}

.page-title {
    font-size: 56px;
    font-weight: 800;
    letter-spacing: -2px;
    margin-bottom: 18px;
    color: #fff5ee;
}

.layout {
    display: grid;
     grid-template-columns: 70% 34%;
    gap: 18px;
    align-items: start;
}
@media (max-width: 1180px) {
    .layout {
        grid-template-columns: 1fr;
    }
}

.card {
    background: var(--panel);
    border: 1px solid #1b2c4b;
    border-radius: 22px;
    padding: 18px;
    box-shadow: inset 0 0 0 1px rgba(255,255,255,.015);
}

.card-title {
    font-size: 18px;
    font-weight: 800;
    color: white;
    margin-bottom: 14px;
}

.flash {
    border-radius: 12px;
    padding: 12px 14px;
    margin-bottom: 12px;
    font-size: 14px;
}

.flash-success {
    background: rgba(47,191,143,.12);
    border: 1px solid rgba(47,191,143,.32);
    color: #67e3b5;
}

.flash-error {
    background: rgba(255,107,129,.12);
    border: 1px solid rgba(255,107,129,.32);
    color: #ff96a6;
}

.search-bar {
    display: flex;
    gap: 10px;
    align-items: center;
    flex-wrap: wrap;
    margin-bottom: 12px;
}

.search-bar select {
    width: 170px;
    flex-shrink: 0;
}

input[type="text"],
input[type="email"],
input[type="number"],
textarea,
select {
    width: 100%;
    background: var(--input);
    border: 1px solid var(--input-border);
    color: white;
    border-radius: 12px;
    padding: 10px 14px;
    outline: none;
    font-size: 14px;
    transition: .2s ease;
}

input:focus,
textarea:focus,
select:focus {
    border-color: #7d74ff;
    box-shadow: 0 0 0 3px rgba(125,116,255,.16);
}

textarea {
    resize: vertical;
    min-height: 74px;
}

::placeholder {
    color: #7f92b8;
}

.sf-form > div {
    margin-bottom: 12px;
}

.sf-form label,
label {
    display: block;
    font-size: 13px;
    font-weight: 600;
    color: #eaf0ff;
    margin-bottom: 6px;
}

.sf-form ul {
    list-style: none;
    color: #ff8ea1;
    font-size: 12px;
    margin-top: 4px;
}

.row-2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
}

.table-wrap {
    overflow: auto;
    border-radius: 16px;
    border: 1px solid #233555;
    background: #071124;
    min-height: 445px;
}

table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;
}

thead tr {
    background: #1b2940;
}

thead th {
    padding: 12px 10px;
    text-align: center;
    font-size: 13px;
    font-weight: 700;
    color: #ecf2ff;
    border-right: 1px solid rgba(255,255,255,.08);
    white-space: nowrap;
}

thead th:last-child {
    border-right: none;
}

tbody tr {
    border-bottom: 1px solid #1b2a47;
    transition: .15s ease;
    cursor: pointer;
}

tbody tr:hover {
    background: rgba(125,116,255,.08);
}

tbody tr.selected {
    background: rgba(125,116,255,.14);
}

tbody td {
    padding: 10px 10px;
    text-align: center;
    border-right: 1px solid rgba(255,255,255,.08);
    color: #f2f6ff;
}

tbody td:last-child {
    border-right: none;
}

.empty-state {
    text-align: center;
    padding: 40px;
    color: var(--muted);
    font-style: italic;
}

.chat-msg-row {
    display: flex;
}

.chat-msg-row.user {
    justify-content: flex-end;
}

.chat-msg-row.bot {
    justify-content: flex-start;
}

.chat-bubble {
    max-width: 78%;
    padding: 10px 12px;
    border-radius: 12px;
    line-height: 1.5;
    font-size: 13px;
    white-space: pre-wrap;
    word-break: break-word;
}

.chat-bubble.user {
    background: #21406a;
    color: #e8f1ff;
    border-bottom-right-radius: 4px;
}

.chat-bubble.bot {
    background: #13203a;
    color: #d9e4ff;
    border: 1px solid #24375a;
    border-bottom-left-radius: 4px;
}

.chat-typing {
    font-style: italic;
    color: #8fa3c7;
}
.badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 4px 10px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 600;
    border: 1px solid transparent;
}

.badge-active {
    color: #44d39b;
    background: rgba(47,191,143,.12);
    border-color: rgba(47,191,143,.25);
}

.badge-inactive {
    color: #ff8ea1;
    background: rgba(255,107,129,.12);
    border-color: rgba(255,107,129,.25);
}

.badge-pending {
    color: #66b8ff;
    background: rgba(102,184,255,.12);
    border-color: rgba(102,184,255,.25);
}

.btn-row,
.action-bar {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin-top: 14px;
}

.btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    border: none;
    border-radius: 14px;
    padding: 10px 16px;
    font-size: 14px;
    font-weight: 700;
    cursor: pointer;
    transition: .18s ease;
    color: white;
    white-space: nowrap;
}

.btn:hover {
    transform: translateY(-1px);
    opacity: .94;
}
.assistant-launch-wrap {
    margin-top: 14px;
}

.assistant-launch-btn {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    border: 1px solid #2f4773;
    background: linear-gradient(135deg, #132342, #1a2d54);
    color: #eef4ff;
    border-radius: 16px;
    padding: 12px 16px;
    font-size: 14px;
    font-weight: 700;
    cursor: pointer;
    transition: .2s ease;
    box-shadow: inset 0 0 0 1px rgba(255,255,255,.03);
}

.assistant-launch-btn:hover {
    transform: translateY(-1px);
    border-color: #5f82d1;
    background: linear-gradient(135deg, #17305b, #213b6c);
}

.assistant-icon {
    font-size: 16px;
}

.btn-add,
.btn-edit,
.btn-delete,
.btn-reset,
.btn-ghost,
.btn-sm {
    background: linear-gradient(135deg, var(--purple-2), var(--purple));
}
.search-right {
    display: flex;
    align-items: center;
    gap: 8px;
}
.assistant-window-actions {
    display: flex;
    align-items: center;
    gap: 8px;
}

.assistant-minimize,
.assistant-close {
    background: transparent;
    border: none;
    color: white;
    font-size: 18px;
    line-height: 1;
    cursor: pointer;
    width: 28px;
    height: 28px;
    border-radius: 8px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: .2s ease;
}

.assistant-minimize:hover,
.assistant-close:hover {
    background: rgba(255,255,255,.08);
}

.assistant-window.minimized {
    height: auto;
}

.assistant-window.minimized .assistant-window-messages,
.assistant-window.minimized .assistant-window-input {
    display: none;
}

.search-right input {
    width: 200px;
    padding: 8px 12px;
    font-size: 13px;
}

.btn-search {
    padding: 8px 14px;
    font-size: 13px;
    border-radius: 12px;
    background: linear-gradient(135deg, #6aa2ff, #7d74ff);
}

.btn-delete {
    background: linear-gradient(135deg, #8d8cff, #8570ff);
}

.selected-strip {
    display: none;
    align-items: center;
    gap: 8px;
    background: rgba(125,116,255,.12);
    border: 1px solid rgba(125,116,255,.24);
    color: #c7ccff;
    border-radius: 12px;
    padding: 10px 12px;
    margin-bottom: 12px;
    font-size: 13px;
}

.selected-strip.visible {
    display: flex;
}

.hint {
    margin-top: 10px;
    color: #8fa3c7;
    font-size: 13px;
    line-height: 1.6;
}

.count-pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-left: 12px;
    background: #1a2840;
    border: 1px solid #2a3d63;
    color: #9fb2d9;
    padding: 5px 12px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 700;
}
</style>
{% endblock %}

{% block body %}
<header class="topbar">
    <a href="#" class="brand">
        <img src="{{ asset('image/competences/logo.png') }}" alt="SkillSwap">
        <span>SkillSwap</span>
    </a>

    <div class="topbar-spacer"></div>

    <a href="#" class="nav-link">Accueil</a>
    <a href="{{ path('app_admin_profil') }}" class="nav-link">Profil</a>
    <a href="#" class="nav-link">Offres</a>
</header>

<main class="page">
    <div style="display:flex;align-items:center;gap:10px;margin-bottom:18px;">
        <h3 class="page-title">Compétences</h3>
        <span class="count-pill">{{ competences|length }} entrée{{ competences|length > 1 ? 's' : '' }}</span>
    </div>

    {% for msg in app.flashes('success') %}
        <div class="flash flash-success">✓ {{ msg }}</div>
    {% endfor %}
    {% for msg in app.flashes('error') %}
        <div class="flash flash-error">✗ {{ msg }}</div>
    {% endfor %}

    <div class="layout">
        <div class="card">
            <div class="card-title">Recherche</div>
<form method="GET" action="{{ path('competence_search') }}" class="search-bar">

    {% set attrs = {
        'email':'Email',
        'niveau':'Niveau',
        'type':'Type',
        'category':'Catégorie',
        'certification':'Certification',
        'statut':'Statut',
        'description':'Description'
    } %}

    <select name="type">
        <option value="">Tous</option>
        {% for val, label in attrs %}
            <option value="{{ val }}" {{ app.request.get('type') == val ? 'selected' : '' }}>
                {{ label }}
            </option>
        {% endfor %}
    </select>

    <div class="search-right">
        <input type="text" id="searchInput" name="q" value="{{ app.request.get('q') }}" placeholder="Rechercher...">
       <button type="submit" class="btn btn-search">
        🔍 Rechercher
    </button>
    </div>

</form>

            <div class="table-wrap">
                <table id="competenceTable">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Email</th>
                            <th>Statut</th>
                            <th>Niveau</th>
                            <th>Type</th>
                            <th>Catégorie</th>
                            <th>Certification</th>
                            <th>Expérience</th>
                            <th>Description</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for c in competences %}
                        <tr onclick="fillForm(this)"
                            data-id="{{ c.id }}"
                            data-type="{{ c.type }}"
                            data-category="{{ c.category }}"
                            data-description="{{ c.description }}"
                            data-niveau="{{ c.niveau }}"
                            data-statut="{{ c.statut }}"
                            data-annees="{{ c.anneesExperience }}"
                            data-certification="{{ c.certification }}"
                            data-email="{{ c.email }}">
                            <td>{{ c.id }}</td>
                            <td>{{ c.email }}</td>
                            <td>
                                {% set s = c.statut|lower %}
                                {% if s == 'validée' or s == 'validee' %}
                                    <span class="badge badge-active">{{ c.statut }}</span>
                                {% elseif s == 'expirée' or s == 'expiree' %}
                                    <span class="badge badge-inactive">{{ c.statut }}</span>
                                {% else %}
                                    <span class="badge badge-pending">{{ c.statut }}</span>
                                {% endif %}
                            </td>
                            <td>{{ c.niveau }}</td>
                            <td>{{ c.type }}</td>
                            <td>{{ c.category }}</td>
                            <td>{{ c.certification ?? '—' }}</td>
                            <td>{{ c.anneesExperience }}</td>
                            <td title="{{ c.description }}">
                                {{ c.description|length > 30 ? c.description|slice(0,30) ~ '…' : (c.description ?? '—') }}
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="9" class="empty-state">Aucune compétence enregistrée.</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        

<div class="action-bar">
    <a href="{{ path('competence_export_pdf') }}" class="btn btn-ghost">Télécharger PDF</a>
    <a href="{{ path('competence_calendar') }}" class="btn btn-ghost">Calendrier</a>
   <button type="button" class="btn btn-ghost" onclick="openDashboardModal()">Dashboard</button>
    <a href="{{ path('competence_historique') }}" class="btn btn-ghost">Historique</a>
</div>
        </div>

        <div class="card">
            <div class="card-title" id="formTitle">Changer la liste</div>

            <div class="selected-strip" id="selectedStrip">
                📌 <span id="selectedLabel">Aucune ligne sélectionnée</span>
            </div>

            {{ form_start(form, {
                'attr': {'id': 'competenceForm', 'novalidate': 'novalidate', 'autocomplete': 'off'},
                'action': formAction,
                'method': 'POST'
            }) }}

            <input type="hidden" id="hiddenId" name="competence_id" value="{{ selectedId ?? '' }}">

            <div class="sf-form">
                <div>
                    {{ form_label(form.type, 'Type') }}
                    {{ form_widget(form.type, {'attr': {'placeholder': 'Ex: Java'}}) }}
                    {{ form_errors(form.type) }}
                </div>

                <div>
                    {{ form_label(form.category, 'Catégorie') }}
                    {{ form_widget(form.category, {'attr': {'placeholder': 'Ex: IT'}}) }}
                    {{ form_errors(form.category) }}
                </div>

                <div>
                    {{ form_label(form.description, 'Description') }}
                    {{ form_widget(form.description, {'attr': {'placeholder': 'Description...'}}) }}
                    {{ form_errors(form.description) }}
                </div>

                <div class="row-2">
                    <div>
                        {{ form_label(form.niveau, 'Niveau') }}
                        {{ form_widget(form.niveau) }}
                        {{ form_errors(form.niveau) }}
                    </div>

                    <div>
                        {{ form_label(form.statut, 'Statut') }}
                        {{ form_widget(form.statut) }}
                        {{ form_errors(form.statut) }}
                    </div>
                </div>

                <div>
                    {{ form_label(form.anneesExperience, "Années d'expérience") }}
                    {{ form_widget(form.anneesExperience, {'attr': {'min': 0, 'max': 60}}) }}
                    {{ form_errors(form.anneesExperience) }}
                </div>

                <div>
                    {{ form_label(form.certification, 'Certification') }}
                    {{ form_widget(form.certification, {'attr': {'placeholder': 'Ex: Oracle, AWS...'}}) }}
                    {{ form_errors(form.certification) }}
                </div>

                <div>
    {{ form_label(form.email, 'Email utilisateur') }}
    {{ form_widget(form.email, {'attr': {'placeholder': 'Ex: utilisateur@mail.com'}}) }}
    {{ form_errors(form.email) }}
</div>
            </div>

            <div class="btn-row">
                <button type="button" onclick="doAdd()" class="btn btn-add">Ajouter</button>
                <button type="button" onclick="doEdit()" class="btn btn-edit">Modifier</button>
                <button type="button" onclick="doDelete()" class="btn btn-delete">Supprimer</button>
                <button type="button" onclick="resetForm()" class="btn btn-reset">Réinitialiser</button>
            </div>
          <div class="assistant-launch-wrap">
    <button type="button" class="assistant-launch-btn" onclick="toggleAssistantWindow()">
        💬 Assistant SkillSwap
    </button>
</div>


            {{ form_end(form) }}

            <p class="hint">Astuce : clique sur une ligne pour remplir le formulaire.</p>
        </div>
    </div>
    <div id="assistantWindow" class="assistant-window">
   <div class="assistant-window-header">
    <div>
        <strong>Assistant SkillSwap</strong>
        <div class="assistant-window-subtitle">Recherche de profils depuis le tableau</div>
    </div>

    <div class="assistant-window-actions">
        <button type="button" class="assistant-minimize" onclick="toggleAssistantMinimize()">—</button>
        <button type="button" class="assistant-close" onclick="closeAssistantWindow()">✕</button>
    </div>
</div>
    <div class="assistant-window-messages" id="chatMessages"></div>

    <div class="assistant-window-input">
        <input type="text" id="chatInput" placeholder="Ex: je veux un profil Java validé">
        <button type="button" class="btn btn-ghost" onclick="sendChatMessage()">Envoyer</button>
    </div>
</div>
<div id="dashboardModal" class="dashboard-modal">
    <div class="dashboard-box">
        <div class="dashboard-modal-header">
            <div>
                <div class="dashboard-modal-title">Dashboard Compétences</div>
                <div class="dashboard-modal-subtitle" id="dashboardTopLabel">Type dominant : —</div>
            </div>
            <button type="button" class="dashboard-close" onclick="closeDashboardModal()">✕</button>
        </div>

        <div class="dashboard-modal-body">
            <div class="dashboard-chart-wrap">
                <canvas id="dashboardPieChart"></canvas>
            </div>
        </div>

        <div class="dashboard-modal-footer">
            <button type="button" class="btn btn-ghost" onclick="closeDashboardModal()">Fermer</button>
        </div>
    </div>
</div>
    
</main>
{% endblock %}
{% block javascripts %}
<script>
const ROUTES = {
    add: '{{ path("competence_add") }}',
    edit: '{{ path("competence_edit", {"id": "__ID__"}) }}',
    delete: '{{ path("competence_delete", {"id": "__ID__"}) }}',
};

function fillForm(row) {
    document.querySelectorAll('#competenceTable tbody tr').forEach(r => r.classList.remove('selected'));
    row.classList.add('selected');

    const id = row.dataset.id;
    document.getElementById('hiddenId').value = id;

    setFieldValue('competence_type_type', row.dataset.type);
    setFieldValue('competence_type_category', row.dataset.category);
    setFieldValue('competence_type_description', row.dataset.description);
    setFieldValue('competence_type_anneesExperience', row.dataset.annees);
    setFieldValue('competence_type_certification', row.dataset.certification);
    setFieldValue('competence_type_email', row.dataset.email);

    setSelectValue('competence_type_niveau', row.dataset.niveau);
    setSelectValue('competence_type_statut', row.dataset.statut);

    const strip = document.getElementById('selectedStrip');
    const label = document.getElementById('selectedLabel');
    const title = document.getElementById('formTitle');

    if (label) {
        label.textContent = `ID ${id} | ${row.dataset.type || ''} | ${row.dataset.email || ''}`;
    }

    if (strip) {
        strip.classList.add('visible');
    }

    if (title) {
        title.textContent = 'Modifier la compétence';
    }
}

function setFieldValue(id, value) {
    const el = document.getElementById(id);
    if (!el) return;
    el.value = value ?? '';
    el.dispatchEvent(new Event('input', { bubbles: true }));
    el.dispatchEvent(new Event('change', { bubbles: true }));
}

function setSelectValue(id, value) {
    const el = document.getElementById(id);
    if (!el) return;

    const target = String(value ?? '').trim().toLowerCase();
    let found = false;

    Array.from(el.options).forEach(opt => {
        if (String(opt.value).trim().toLowerCase() === target) {
            el.value = opt.value;
            found = true;
        }
    });

    if (!found) {
        Array.from(el.options).forEach(opt => {
            if (String(opt.text).trim().toLowerCase() === target) {
                el.value = opt.value;
                found = true;
            }
        });
    }

    el.dispatchEvent(new Event('change', { bubbles: true }));
}

function doAdd() {
    const f = document.getElementById('competenceForm');
    f.action = ROUTES.add;
    f.submit();
}

function doEdit() {
    const id = document.getElementById('hiddenId').value;
    if (!id) {
        alert('Sélectionnez d’abord une ligne dans le tableau.');
        return;
    }
    const f = document.getElementById('competenceForm');
    f.action = ROUTES.edit.replace('__ID__', id);
    f.submit();
}

function doDelete() {
    const id = document.getElementById('hiddenId').value;
    if (!id) {
        alert('Sélectionnez d’abord une ligne dans le tableau.');
        return;
    }

    if (!confirm('Supprimer définitivement cette compétence ?')) {
        return;
    }

    const f = document.getElementById('competenceForm');
    f.action = ROUTES.delete.replace('__ID__', id);
    f.method = 'POST';
    f.submit();
}

function resetForm() {
    const form = document.getElementById('competenceForm');
    form.reset();

    document.getElementById('hiddenId').value = '';
    document.querySelectorAll('#competenceTable tbody tr').forEach(r => r.classList.remove('selected'));

    const strip = document.getElementById('selectedStrip');
    const label = document.getElementById('selectedLabel');
    const title = document.getElementById('formTitle');

    if (strip) strip.classList.remove('visible');
    if (label) label.textContent = 'Aucune ligne sélectionnée';
    if (title) title.textContent = 'Changer la liste';
}
document.addEventListener("DOMContentLoaded", function () {

    const searchInput = document.getElementById('searchInput');

    if (!searchInput) return;

    searchInput.addEventListener('input', function () {
        const value = this.value.toLowerCase();
        const rows = document.querySelectorAll('#competenceTable tbody tr');

        rows.forEach(row => {

            // ignorer la ligne "Aucune compétence"
            if (row.querySelector('.empty-state')) return;

            const text = row.innerText.toLowerCase();

            if (text.includes(value)) {
                row.style.display = '';
            } else {
                row.style.display = 'none';
            }
        });
    });

});


function addChatMessage(role, text) {
    const box = document.getElementById('chatMessages');
    const row = document.createElement('div');
    row.className = 'chat-msg-row ' + role;

    const bubble = document.createElement('div');
    bubble.className = 'chat-bubble ' + role;
    bubble.textContent = text;

    row.appendChild(bubble);
    box.appendChild(row);
    box.scrollTop = box.scrollHeight;
}

function addChatUserMessage(text) {
    addChatMessage('user', text);
}

function addChatBotMessage(text) {
    addChatMessage('bot', text);
}

function addChatTyping() {
    const box = document.getElementById('chatMessages');
    const row = document.createElement('div');
    row.className = 'chat-msg-row bot';
    row.id = 'chatTypingRow';

    const bubble = document.createElement('div');
    bubble.className = 'chat-bubble bot chat-typing';
    bubble.textContent = "En train d'écrire…";

    row.appendChild(bubble);
    box.appendChild(row);
    box.scrollTop = box.scrollHeight;
}

function removeChatTyping() {
    const el = document.getElementById('chatTypingRow');
    if (el) el.remove();
}

async function sendChatMessage() {
    const input = document.getElementById('chatInput');
    const text = input.value.trim();
    if (!text) return;

    input.value = '';
    addChatUserMessage(text);
    addChatTyping();

    try {
        const response = await fetch('{{ path("competence_chatbot_send") }}', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({ message: text })
        });

        const data = await response.json();
        removeChatTyping();

        if (!response.ok) {
            addChatBotMessage(data.reply || "Erreur lors du traitement.");
            return;
        }

        addChatBotMessage(data.reply || "Aucune réponse.");
    } catch (e) {
        removeChatTyping();
        addChatBotMessage("Erreur de connexion avec le serveur.");
    }
}

document.addEventListener('DOMContentLoaded', function () {
    const chatInput = document.getElementById('chatInput');
    if (chatInput) {
        chatInput.addEventListener('keydown', function (e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                sendChatMessage();
            }
        });
    }
});
function toggleAssistantWindow() {
    const win = document.getElementById('assistantWindow');
    if (!win) return;

    const isOpening = !win.classList.contains('open');

    if (isOpening) {
        win.classList.add('open');
        win.classList.remove('minimized');

        const chatMessages = document.getElementById('chatMessages');
        if (chatMessages && chatMessages.innerHTML.trim() === '') {
            addChatBotMessage("Bienvenue sur SkillSwap.\nJe peux chercher dans le tableau des compétences.\n\nExemples :\n- je veux un profil java\n- cherche marketing validé\n- donne moi un expert design");
        }
        return;
    }

    win.classList.remove('open');
    win.classList.remove('minimized');
}

function closeAssistantWindow() {
    const win = document.getElementById('assistantWindow');
    if (!win) return;

    win.classList.remove('open');
    win.classList.remove('minimized');
}

function toggleAssistantMinimize() {
    const win = document.getElementById('assistantWindow');
    if (!win || !win.classList.contains('open')) return;

    win.classList.toggle('minimized');
}











let dashboardChartInstance = null;

const dashboardRawData = {
    parType: {{ stats.parType|default({})|json_encode|raw }},
    total: {{ stats.total|default(0) }}
};

function openDashboardModal() {
    const modal = document.getElementById('dashboardModal');
    if (!modal) return;

    modal.classList.add('open');
    renderDashboardChart();
}

function closeDashboardModal() {
    const modal = document.getElementById('dashboardModal');
    if (!modal) return;

    modal.classList.remove('open');
}

function renderDashboardChart() {
    const topLabel = document.getElementById('dashboardTopLabel');
    const canvas = document.getElementById('dashboardPieChart');

    if (!canvas) return;

    if (dashboardChartInstance) {
        dashboardChartInstance.destroy();
        dashboardChartInstance = null;
    }

    if (!dashboardRawData.total || dashboardRawData.total === 0) {
        if (topLabel) topLabel.textContent = 'Aucune donnée.';
        return;
    }

    const entries = Object.entries(dashboardRawData.parType)
        .sort((a, b) => b[1] - a[1]);

    const labels = entries.map(([k, v]) => {
        const pct = ((v / dashboardRawData.total) * 100).toFixed(1);
        return `${k} (${pct}%)`;
    });

    const values = entries.map(([, v]) => v);

    const [topKey, topVal] = entries[0];
    const topPct = ((topVal / dashboardRawData.total) * 100).toFixed(1);

    if (topLabel) {
        topLabel.textContent = `Type dominant : ${topKey} (${topPct}%)`;
    }

    const palette = [
        '#e66831',
        '#eba02b',
        '#5db257',
        '#56b2d6',
        '#8d73ff',
        '#ff6b81',
        '#2fbf8f',
        '#f4c542'
    ];

    dashboardChartInstance = new Chart(canvas, {
        type: 'pie',
        data: {
            labels: labels,
            datasets: [{
                data: values,
                backgroundColor: palette.slice(0, values.length),
                borderColor: '#f3f6ff',
                borderWidth: 1.5,
                hoverOffset: 6
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            layout: {
                padding: 10
            },
            plugins: {
                title: {
                    display: true,
                    text: 'Répartition des compétences',
                    color: '#ffffff',
                    font: {
                        size: 16,
                        weight: '600',
                        family: 'Inter'
                    },
                    padding: {
                        bottom: 14
                    }
                },
                legend: {
                    position: 'bottom',
                    labels: {
                        color: '#ffffff',
                        usePointStyle: true,
                        pointStyle: 'circle',
                        boxWidth: 10,
                        padding: 14,
                        font: {
                            size: 12,
                            family: 'Inter'
                        }
                    }
                },
                tooltip: {
                    callbacks: {
                        label: function(ctx) {
                            const total = dashboardRawData.total || 1;
                            const val = ctx.parsed || 0;
                            const pct = ((val / total) * 100).toFixed(1);
                            return ` ${ctx.label} : ${val} entrée(s)`;
                        }
                    }
                }
            }
        }
    });
}

document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') {
        closeDashboardModal();
    }
});

document.addEventListener('click', function (e) {
    const modal = document.getElementById('dashboardModal');
    if (!modal || !modal.classList.contains('open')) return;

    if (e.target === modal) {
        closeDashboardModal();
    }
});

</script>

{% endblock %}