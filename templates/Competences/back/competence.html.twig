{% block javascripts %}
<script>
const ROUTES = {
    add: '{{ path("competence_add") }}',
    edit: '{{ path("competence_edit", {"id": "__ID__"}) }}',
    delete: '{{ path("competence_delete", {"id": "__ID__"}) }}',
};

function fillForm(row) {
    document.querySelectorAll('#competenceTable tbody tr').forEach(r => r.classList.remove('selected'));
    row.classList.add('selected');

    const id = row.dataset.id;
    document.getElementById('hiddenId').value = id;

    setFieldValue('competence_type_type', row.dataset.type);
    setFieldValue('competence_type_category', row.dataset.category);
    setFieldValue('competence_type_description', row.dataset.description);
    setFieldValue('competence_type_anneesExperience', row.dataset.annees);
    setFieldValue('competence_type_certification', row.dataset.certification);
    setFieldValue('competence_type_email', row.dataset.email);

    setSelectValue('competence_type_niveau', row.dataset.niveau);
    setSelectValue('competence_type_statut', row.dataset.statut);

    const strip = document.getElementById('selectedStrip');
    const label = document.getElementById('selectedLabel');
    const title = document.getElementById('formTitle');

    if (label) {
        label.textContent = `ID ${id} | ${row.dataset.type || ''} | ${row.dataset.email || ''}`;
    }

    if (strip) {
        strip.classList.add('visible');
    }

    if (title) {
        title.textContent = 'Modifier la compétence';
    }
}

function setFieldValue(id, value) {
    const el = document.getElementById(id);
    if (!el) return;
    el.value = value ?? '';
    el.dispatchEvent(new Event('input', { bubbles: true }));
    el.dispatchEvent(new Event('change', { bubbles: true }));
}

function setSelectValue(id, value) {
    const el = document.getElementById(id);
    if (!el) return;

    const target = String(value ?? '').trim().toLowerCase();
    let found = false;

    Array.from(el.options).forEach(opt => {
        if (String(opt.value).trim().toLowerCase() === target) {
            el.value = opt.value;
            found = true;
        }
    });

    if (!found) {
        Array.from(el.options).forEach(opt => {
            if (String(opt.text).trim().toLowerCase() === target) {
                el.value = opt.value;
                found = true;
            }
        });
    }

    el.dispatchEvent(new Event('change', { bubbles: true }));
}

function doAdd() {
    const f = document.getElementById('competenceForm');
    f.action = ROUTES.add;
    f.submit();
}

function doEdit() {
    const id = document.getElementById('hiddenId').value;
    if (!id) {
        alert('Sélectionnez d’abord une ligne dans le tableau.');
        return;
    }
    const f = document.getElementById('competenceForm');
    f.action = ROUTES.edit.replace('__ID__', id);
    f.submit();
}

function doDelete() {
    const id = document.getElementById('hiddenId').value;
    if (!id) {
        alert('Sélectionnez d’abord une ligne dans le tableau.');
        return;
    }

    if (!confirm('Supprimer définitivement cette compétence ?')) {
        return;
    }

    const f = document.getElementById('competenceForm');
    f.action = ROUTES.delete.replace('__ID__', id);
    f.method = 'POST';
    f.submit();
}

function resetForm() {
    const form = document.getElementById('competenceForm');
    form.reset();

    document.getElementById('hiddenId').value = '';
    document.querySelectorAll('#competenceTable tbody tr').forEach(r => r.classList.remove('selected'));

    const strip = document.getElementById('selectedStrip');
    const label = document.getElementById('selectedLabel');
    const title = document.getElementById('formTitle');

    if (strip) strip.classList.remove('visible');
    if (label) label.textContent = 'Aucune ligne sélectionnée';
    if (title) title.textContent = 'Changer la liste';
}
document.addEventListener("DOMContentLoaded", function () {

    const searchInput = document.getElementById('searchInput');

    if (!searchInput) return;

    searchInput.addEventListener('input', function () {
        const value = this.value.toLowerCase();
        const rows = document.querySelectorAll('#competenceTable tbody tr');

        rows.forEach(row => {

            // ignorer la ligne "Aucune compétence"
            if (row.querySelector('.empty-state')) return;

            const text = row.innerText.toLowerCase();

            if (text.includes(value)) {
                row.style.display = '';
            } else {
                row.style.display = 'none';
            }
        });
    });

});


function addChatMessage(role, text) {
    const box = document.getElementById('chatMessages');
    const row = document.createElement('div');
    row.className = 'chat-msg-row ' + role;

    const bubble = document.createElement('div');
    bubble.className = 'chat-bubble ' + role;
    bubble.textContent = text;

    row.appendChild(bubble);
    box.appendChild(row);
    box.scrollTop = box.scrollHeight;
}

function addChatUserMessage(text) {
    addChatMessage('user', text);
}

function addChatBotMessage(text) {
    addChatMessage('bot', text);
}

function addChatTyping() {
    const box = document.getElementById('chatMessages');
    const row = document.createElement('div');
    row.className = 'chat-msg-row bot';
    row.id = 'chatTypingRow';

    const bubble = document.createElement('div');
    bubble.className = 'chat-bubble bot chat-typing';
    bubble.textContent = "En train d'écrire…";

    row.appendChild(bubble);
    box.appendChild(row);
    box.scrollTop = box.scrollHeight;
}

function removeChatTyping() {
    const el = document.getElementById('chatTypingRow');
    if (el) el.remove();
}

async function sendChatMessage() {
    const input = document.getElementById('chatInput');
    const text = input.value.trim();
    if (!text) return;

    input.value = '';
    addChatUserMessage(text);
    addChatTyping();

    try {
        const response = await fetch('{{ path("competence_chatbot_send") }}', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({ message: text })
        });

        const data = await response.json();
        removeChatTyping();

        if (!response.ok) {
            addChatBotMessage(data.reply || "Erreur lors du traitement.");
            return;
        }

        addChatBotMessage(data.reply || "Aucune réponse.");
    } catch (e) {
        removeChatTyping();
        addChatBotMessage("Erreur de connexion avec le serveur.");
    }
}

document.addEventListener('DOMContentLoaded', function () {
    const chatInput = document.getElementById('chatInput');
    if (chatInput) {
        chatInput.addEventListener('keydown', function (e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                sendChatMessage();
            }
        });
    }
});
function toggleAssistantWindow() {
    const win = document.getElementById('assistantWindow');
    if (!win) return;

    const isOpening = !win.classList.contains('open');

    if (isOpening) {
        win.classList.add('open');
        win.classList.remove('minimized');

        const chatMessages = document.getElementById('chatMessages');
        if (chatMessages && chatMessages.innerHTML.trim() === '') {
            addChatBotMessage("Bienvenue sur SkillSwap.\nJe peux chercher dans le tableau des compétences.\n\nExemples :\n- je veux un profil java\n- cherche marketing validé\n- donne moi un expert design");
        }
        return;
    }

    win.classList.remove('open');
    win.classList.remove('minimized');
}

function closeAssistantWindow() {
    const win = document.getElementById('assistantWindow');
    if (!win) return;

    win.classList.remove('open');
    win.classList.remove('minimized');
}

function toggleAssistantMinimize() {
    const win = document.getElementById('assistantWindow');
    if (!win || !win.classList.contains('open')) return;

    win.classList.toggle('minimized');
}



let historiqueRows = [];

function openHistoriqueModal() {
    const modal = document.getElementById('historiqueModal');
    modal.classList.add('open');
    loadHistorique();
}

function closeHistoriqueModal() {
    document.getElementById('historiqueModal').classList.remove('open');
}

async function loadHistorique() {
    const tbody = document.getElementById('historiqueTbody');
    const hint = document.getElementById('historiqueHint');
    tbody.innerHTML = '<tr><td colspan="11" class="empty-state">Chargement...</td></tr>';

    try {
        const res = await fetch('{{ path("competence_historique_data") }}');
        const data = await res.json();
        historiqueRows = data.items || [];
        renderHistoriqueRows();
        hint.textContent = '';
    } catch (e) {
        console.error(e);
        tbody.innerHTML = '<tr><td colspan="11" class="empty-state">Erreur de chargement.</td></tr>';
        hint.textContent = 'Erreur lors du chargement de l’historique.';
    }
}

function renderHistoriqueRows() {
    const tbody = document.getElementById('historiqueTbody');
    const attr = document.getElementById('histAttr').value;
    const q = document.getElementById('histSearch').value.toLowerCase().trim();

    const filtered = historiqueRows.filter(row => {
        if (!q) return true;

        const annees = String(row.anneesExperience ?? '');
        const fields = {
            statusChange: row.statusChange ?? '',
            dateModification: row.dateModification ?? '',
            email: row.email ?? '',
            type: row.type ?? '',
            category: row.category ?? '',
            niveau: row.niveau ?? '',
            anneesExperience: annees,
            statut: row.statut ?? '',
            certification: row.certification ?? '',
            description: row.description ?? '',
        };

        if (attr === 'all') {
            return Object.values(fields).some(v => String(v).toLowerCase().includes(q));
        }

        return String(fields[attr] ?? '').toLowerCase().includes(q);
    });

    if (!filtered.length) {
        tbody.innerHTML = '<tr><td colspan="11" class="empty-state">Aucun historique trouvé.</td></tr>';
        return;
    }

    tbody.innerHTML = filtered.map(row => `
        <tr>
            <td><input type="checkbox" class="hist-check" value="${row.id}"></td>
            <td>${escapeHtml(row.statusChange ?? '')}</td>
            <td>${formatDate(row.dateModification)}</td>
            <td>${escapeHtml(row.email ?? '')}</td>
            <td>${escapeHtml(row.category ?? '')}</td>
            <td>${escapeHtml(row.type ?? '')}</td>
            <td>${escapeHtml(row.niveau ?? '')}</td>
            <td>${escapeHtml(String(row.anneesExperience ?? ''))}</td>
            <td>${escapeHtml(row.statut ?? '')}</td>
            <td>${escapeHtml(row.certification ?? '')}</td>
            <td title="${escapeHtml(row.description ?? '')}">
                ${escapeHtml(shortText(row.description ?? '', 40))}
            </td>
        </tr>
    `).join('');
}
async function sendStatusMail(button, id, email, statut) {
    if (!id || !button) return;

    try {
        const response = await fetch(
            '{{ path("competence_send_mail", {"id": "__ID__"}) }}'.replace('__ID__', id),
            {
                method: 'POST',
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                }
            }
        );

        const data = await response.json().catch(() => ({}));

        if (!response.ok) {
            console.error(data.message || "Erreur lors de l'envoi du mail.");
            return;
        }

        button.classList.remove('status-link-strong');
        button.classList.add('status-link-soft', 'is-disabled');
        button.disabled = true;
        button.onclick = null;
    } catch (e) {
        console.error("Erreur de connexion lors de l'envoi du mail.");
    }
}

function deleteSelectedHistorique() {
    const ids = Array.from(document.querySelectorAll('.hist-check:checked')).map(el => parseInt(el.value, 10));
    if (!ids.length) {
        document.getElementById('historiqueHint').textContent = 'Veuillez sélectionner au moins une ligne.';
        return;
    }

    if (!confirm(`Supprimer ${ids.length} ligne(s) sélectionnée(s) ?`)) {
        return;
    }

    fetch('{{ path("competence_historique_delete_multiple") }}', {
        method: 'POST',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({ ids })
    })
    .then(r => r.json())
    .then(() => loadHistorique())
    .catch(() => {
        document.getElementById('historiqueHint').textContent = 'Erreur suppression.';
    });
}

function resetHistoriqueFilters() {
    document.getElementById('histAttr').value = 'all';
    document.getElementById('histSearch').value = '';
    renderHistoriqueRows();
}

function formatDate(v) {
    if (!v) return '';
    const d = new Date(v.replace(' ', 'T'));
    if (isNaN(d)) return v;
    return d.toLocaleString('fr-FR');
}

function shortText(s, max) {
    return s.length > max ? s.slice(0, max) + '…' : s;
}

function escapeHtml(str) {
    return String(str)
        .replaceAll('&', '&amp;')
        .replaceAll('<', '&lt;')
        .replaceAll('>', '&gt;')
        .replaceAll('"', '&quot;')
        .replaceAll("'", '&#039;');
}

document.addEventListener('DOMContentLoaded', function () {
    document.getElementById('histAttr').addEventListener('change', renderHistoriqueRows);
    document.getElementById('histSearch').addEventListener('input', renderHistoriqueRows);

    document.getElementById('histSelectAll').addEventListener('change', function () {
        document.querySelectorAll('.hist-check').forEach(cb => cb.checked = this.checked);
    });
});





let dashboardChartInstance = null;

const dashboardRawData = {
    parType: {{ stats.parType|default({})|json_encode|raw }},
    total: {{ stats.total|default(0) }}
};

function openDashboardModal() {
    const modal = document.getElementById('dashboardModal');
    if (!modal) return;

    modal.classList.add('open');
    renderDashboardChart();
}

function closeDashboardModal() {
    const modal = document.getElementById('dashboardModal');
    if (!modal) return;

    modal.classList.remove('open');
}

function renderDashboardChart() {
    const topLabel = document.getElementById('dashboardTopLabel');
    const canvas = document.getElementById('dashboardPieChart');

    if (!canvas) return;

    if (dashboardChartInstance) {
        dashboardChartInstance.destroy();
        dashboardChartInstance = null;
    }

    if (!dashboardRawData.total || dashboardRawData.total === 0) {
        if (topLabel) topLabel.textContent = 'Aucune donnée.';
        return;
    }

    const entries = Object.entries(dashboardRawData.parType)
        .sort((a, b) => b[1] - a[1]);

    const labels = entries.map(([k, v]) => {
        const pct = ((v / dashboardRawData.total) * 100).toFixed(1);
        return `${k} (${pct}%)`;
    });

    const values = entries.map(([, v]) => v);

    const [topKey, topVal] = entries[0];
    const topPct = ((topVal / dashboardRawData.total) * 100).toFixed(1);

    if (topLabel) {
        topLabel.textContent = `Type dominant : ${topKey} (${topPct}%)`;
    }

    const palette = [
        '#e66831',
        '#eba02b',
        '#5db257',
        '#56b2d6',
        '#8d73ff',
        '#ff6b81',
        '#2fbf8f',
        '#f4c542'
    ];

    dashboardChartInstance = new Chart(canvas, {
        type: 'pie',
        data: {
            labels: labels,
            datasets: [{
                data: values,
                backgroundColor: palette.slice(0, values.length),
                borderColor: '#f3f6ff',
                borderWidth: 1.5,
                hoverOffset: 6
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            layout: {
                padding: 10
            },
            plugins: {
                title: {
                    display: true,
                    text: 'Répartition des compétences',
                    color: '#ffffff',
                    font: {
                        size: 16,
                        weight: '600',
                        family: 'Inter'
                    },
                    padding: {
                        bottom: 14
                    }
                },
                legend: {
                    position: 'bottom',
                    labels: {
                        color: '#ffffff',
                        usePointStyle: true,
                        pointStyle: 'circle',
                        boxWidth: 10,
                        padding: 14,
                        font: {
                            size: 12,
                            family: 'Inter'
                        }
                    }
                },
                tooltip: {
                    callbacks: {
                        label: function(ctx) {
                            const total = dashboardRawData.total || 1;
                            const val = ctx.parsed || 0;
                            const pct = ((val / total) * 100).toFixed(1);
                            return ` ${ctx.label} : ${val} entrée(s)`;
                        }
                    }
                }
            }
        }
    });
}

document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') {
        closeDashboardModal();
    }
});

document.addEventListener('click', function (e) {
    const modal = document.getElementById('dashboardModal');
    if (!modal || !modal.classList.contains('open')) return;

    if (e.target === modal) {
        closeDashboardModal();
    }
});

</script>

