{# templates/Competences/back/competence.html.twig #}
{% extends 'base.html.twig' %}
{% block title %}Compétences · SkillSwap{% endblock %}

{% block stylesheets %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
<style>
*, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

:root {
    --bg: #020b1d;
    --top: #081225;
    --panel: #081328;
    --panel-2: #0c1830;
    --line: #203152;
    --line-soft: #1a2842;
    --text: #f6f8ff;
    --muted: #8fa3c7;
    --input: #1a2742;
    --input-border: #31476e;
    --purple: #7d74ff;
    --purple-2: #6aa2ff;
    --danger: #ff6b81;
    --warning: #f4c542;
    --success: #2fbf8f;
}
.assistant-launch-wrap {
    margin-top: 14px;
}.status-link {
    background: transparent;
    border: none;
    padding: 0;
    margin: 0;
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    font-weight: 500;
    line-height: 1;
    text-decoration: none;
    transition: opacity .18s ease, color .18s ease;
}

.status-link:focus {
    outline: none;
    box-shadow: none;
}
.form-flashes {
    margin-top: 12px;
}

.form-flashes .flash {
    margin-bottom: 10px;
}

.status-link-strong {
    color: #00cfff;
    opacity: .98;
    cursor: pointer;
}

.status-link-strong:hover {
    color: #32d8ff;
    text-decoration: underline;
}

.status-link-soft {
    color: #0d7fb8;
    opacity: .72;
    cursor: default;
}

.status-link.is-disabled,
.status-link:disabled {
    pointer-events: none;
    text-decoration: none;
}
.assistant-launch-btn {
    width: 100%;
    border: 1px solid #2f4773;
    background: linear-gradient(135deg, #132342, #1a2d54);
    color: #eef4ff;
    border-radius: 16px;
    padding: 12px 16px;
    font-size: 14px;
    font-weight: 700;
    cursor: pointer;
    transition: .2s ease;
}
.dashboard-modal {
    position: fixed;
    inset: 0;
    background: rgba(2, 8, 24, .58);
    display: none;
    align-items: center;
    justify-content: center;
    z-index: 10000;
    padding: 20px;
}

.dashboard-modal.open {
    display: flex;
}

.dashboard-box {
    width: min(720px, 100%);
    background: #03122b;
    border: 1px solid #1f365e;
    border-radius: 24px;
    box-shadow: 0 26px 60px rgba(0,0,0,.45);
    overflow: hidden;
}

.dashboard-modal-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 12px;
    padding: 18px 20px 10px;
}

.dashboard-modal-title {
    font-size: 19px;
    font-weight: 800;
    color: #ffffff;
}

.dashboard-modal-subtitle {
    font-size: 14px;
    color: #d7e5ff;
    margin-top: 4px;
}

.dashboard-close {
    background: transparent;
    border: none;
    color: #ffffff;
    font-size: 22px;
    cursor: pointer;
    width: 34px;
    height: 34px;
    border-radius: 10px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
}

.dashboard-close:hover {
    background: rgba(255,255,255,.08);
}

.dashboard-modal-body {
    padding: 4px 20px 14px;
}

.dashboard-chart-wrap {
    position: relative;
    width: 100%;
    height: 420px;
    background: transparent;
}

.dashboard-modal-footer {
    display: flex;
    justify-content: flex-end;
    padding: 0 20px 18px;
    .status-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 82px;
    padding: 7px 14px;
    border-radius: 999px;
    border: 1px solid transparent;
    background: transparent;
    font-size: 12px;
    font-weight: 700;
    cursor: pointer;
    transition: .18s ease;
    text-decoration: none;
}

.status-link:hover {
    transform: translateY(-1px);
    box-shadow: 0 6px 18px rgba(0,0,0,.18);
}

.status-link-valid {
    color: #44d39b;
    background: rgba(47,191,143,.10);
    border-color: rgba(47,191,143,.30);
}

.status-link-expired {
    color: #ff8ea1;
    background: rgba(255,107,129,.10);
    border-color: rgba(255,107,129,.30);
}

.status-link-pending {
    color: #66b8ff;
    background: rgba(102,184,255,.10);
    border-color: rgba(102,184,255,.24);
}

.status-link.is-disabled,
.status-link:disabled {
    opacity: .55;
    cursor: not-allowed;
    box-shadow: none;
    transform: none;
}
}
.assistant-launch-btn:hover {
    transform: translateY(-1px);
    border-color: #5f82d1;
    background: linear-gradient(135deg, #17305b, #213b6c);
}

.assistant-window {
    position: fixed;
    right: 26px;
    bottom: 26px;
    width: 360px;
    height: 500px;
    background: #0a152d;
    border: 1px solid #233555;
    border-radius: 18px;
    box-shadow: 0 20px 45px rgba(0,0,0,.35);
    display: none;
    flex-direction: column;
    z-index: 9999;
    overflow: hidden;
}

.assistant-window.open {
    display: flex;
}

.assistant-window-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 14px 16px;
    border-bottom: 1px solid #223454;
    background: #0c1830;
}

.assistant-window-subtitle {
    font-size: 12px;
    color: #8fa3c7;
    margin-top: 2px;
}

.assistant-close {
    background: transparent;
    border: none;
    color: white;
    font-size: 18px;
    cursor: pointer;
}

.assistant-window-messages {
    flex: 1;
    overflow-y: auto;
    padding: 14px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    background: #091223;
}

.assistant-window-input {
    display: flex;
    gap: 8px;
    padding: 12px;
    border-top: 1px solid #223454;
    background: #0c1830;
}

.assistant-window-input input {
    flex: 1;
    background: #16233d;
    border: 1px solid #31476e;
    color: white;
    border-radius: 10px;
    padding: 10px 12px;
    outline: none;
    font-size: 13px;
}

.assistant-window-input input:focus {
    border-color: #7d74ff;
    box-shadow: 0 0 0 3px rgba(125,116,255,.16);
}
html, body {
    background: var(--bg);
    color: var(--text);
    font-family: 'Inter', sans-serif;
    min-height: 100vh;
    overflow-x: hidden;
}

.chat-msg-row {
    display: flex;
}

.chat-msg-row.user {
    justify-content: flex-end;
}

.chat-msg-row.bot {
    justify-content: flex-start;
}

.chat-bubble {
    max-width: 80%;
    padding: 10px 12px;
    border-radius: 12px;
    line-height: 1.5;
    font-size: 13px;
    white-space: pre-wrap;
    word-break: break-word;
}

.chat-bubble.user {
    background: #21406a;
    color: #e8f1ff;
    border-bottom-right-radius: 4px;
}

.chat-bubble.bot {
    background: #13203a;
    color: #d9e4ff;
    border: 1px solid #24375a;
    border-bottom-left-radius: 4px;
}



.chat-typing {
    font-style: italic;
    color: #8fa3c7;
}
a {
    text-decoration: none;
    color: inherit;
}

.topbar {
    height: 64px;
    background: var(--top);
    border-bottom: 1px solid #112241;
    display: flex;
    align-items: center;
    padding: 0 26px;
    gap: 16px;
}

.brand {
    display: flex;
    align-items: center;
    gap: 12px;
}

.brand img {
    width: 40px;
    height: 40px;
    object-fit: contain;
}

.brand span {
    color: #ffffff;
    font-size: 15px;
    font-weight: 700;
}

.topbar-spacer {
    flex: 1;
}

.nav-link {
    font-size: 13px;
    color: #f5f7ff;
    opacity: .9;
    padding: 8px 10px;
    border-radius: 10px;
    transition: .2s ease;
}

.nav-link:hover {
    background: rgba(255,255,255,.05);
    opacity: 1;
}

.page-title {
    font-size: 56px;
    font-weight: 800;
    letter-spacing: -2px;
    margin-bottom: 18px;
    color: #fff5ee;
}

.layout {
    display: grid;
     grid-template-columns: 80% 35%;
    gap: 18px;
    align-items: start;
}

.page {
    max-width: 1300px;
    margin-left: 200px;  /* ajuste ici */
    margin-right: auto;
    padding: 26px 18px 40px;
} 

@media (max-width: 1180px) {
    .layout {
        grid-template-columns: 1fr;
    }
}

.card {
    background: var(--panel);
    border: 1px solid #1b2c4b;
    border-radius: 22px;
    padding: 18px;
    box-shadow: inset 0 0 0 1px rgba(255,255,255,.015);
}

.card-title {
    font-size: 18px;
    font-weight: 800;
    color: white;
    margin-bottom: 14px;
}

.flash {
    background: transparent;
    border: none;
    padding: 0;
    margin-top: 10px;
    font-size: 13px;
    font-weight: 400;
    color: #8fa3c7;
}

.flash-success,
.flash-error {
    background: transparent;
    border: none;
    color: #8fa3c7;
}

.search-bar {
    display: flex;
    gap: 10px;
    align-items: center;
    flex-wrap: wrap;
    margin-bottom: 12px;
}

.search-bar select {
    width: 170px;
    flex-shrink: 0;
}

input[type="text"],
input[type="email"],
input[type="number"],
textarea,
select {
    width: 100%;
    background: var(--input);
    border: 1px solid var(--input-border);
    color: white;
    border-radius: 12px;
    padding: 10px 14px;
    outline: none;
    font-size: 14px;
    transition: .2s ease;
}

input:focus,
textarea:focus,
select:focus {
    border-color: #7d74ff;
    box-shadow: 0 0 0 3px rgba(125,116,255,.16);
}

textarea {
    resize: vertical;
    min-height: 74px;
}

::placeholder {
    color: #7f92b8;
}

.sf-form > div {
    margin-bottom: 12px;
}

.sf-form label,
label {
    display: block;
    font-size: 13px;
    font-weight: 600;
    color: #eaf0ff;
    margin-bottom: 6px;
}

.sf-form ul {
    list-style: none;
    color: #ff8ea1;
    font-size: 12px;
    margin-top: 4px;
}

.row-2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
}
.table-wrap {
    overflow: auto;
    border-radius: 0;
    border: 1px solid #31476e;
    background: #071124;
    min-height: 445px;
}

table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;
}
thead tr {
    background: #1a2740;
}

thead th {
    padding: 14px 10px;
    text-align: center;
    font-size: 13px;
    font-weight: 700;
    color: #ecf2ff;
    border-right: 1px solid rgba(255,255,255,.08);
    white-space: nowrap;
}

thead th:last-child {
    border-right: none;
}

tbody tr {
    border-bottom: 1px solid #2a3a5f;
    transition: .15s ease;
    cursor: pointer;
}

/* Lignes alternées comme dans la capture */
tbody tr:nth-child(odd) {
    background: #0a1830;   /* bleu très foncé */
}

tbody tr:nth-child(even) {
    background: #101f3d;   /* bleu/violet foncé */
}

/* Hover */
tbody tr:hover {
    background: #1a2b52 !important;
}

/* Ligne sélectionnée */
tbody tr.selected {
    background: #243768 !important;
}

/* Cellules */
tbody td {
    padding: 10px 10px;
    text-align: center;
    border-right: 1px solid rgba(255,255,255,.08);
    color: #f2f6ff;
}

tbody td {
    padding: 10px 10px;
    text-align: center;
    border-right: 1px solid rgba(255,255,255,.08);
    color: #f2f6ff;
}

tbody td:last-child {
    border-right: none;
}

.empty-state {
    text-align: center;
    padding: 40px;
    color: var(--muted);
    font-style: italic;
}

.chat-msg-row {
    display: flex;
}

.chat-msg-row.user {
    justify-content: flex-end;
}

.chat-msg-row.bot {
    justify-content: flex-start;
}

.chat-bubble {
    max-width: 78%;
    padding: 10px 12px;
    border-radius: 12px;
    line-height: 1.5;
    font-size: 13px;
    white-space: pre-wrap;
    word-break: break-word;
}

.chat-bubble.user {
    background: #21406a;
    color: #e8f1ff;
    border-bottom-right-radius: 4px;
}

.chat-bubble.bot {
    background: #13203a;
    color: #d9e4ff;
    border: 1px solid #24375a;
    border-bottom-left-radius: 4px;
}

.chat-typing {
    font-style: italic;
    color: #8fa3c7;
}
.badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 4px 10px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 600;
    border: 1px solid transparent;
}

.badge-active {
    color: #44d39b;
    background: rgba(47,191,143,.12);
    border-color: rgba(47,191,143,.25);
}

.badge-inactive {
    color: #ff8ea1;
    background: rgba(255,107,129,.12);
    border-color: rgba(255,107,129,.25);
}

.badge-pending {
    color: #66b8ff;
    background: rgba(102,184,255,.12);
    border-color: rgba(102,184,255,.25);
}
.btn-row {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 14px;
    width: 100%;
}

.btn-row .btn {
    flex: 1 1 0;
    min-width: 0;
    width: 0;
    padding: 10px 12px;
    font-size: 14px;
    border-radius: 16px;
    justify-content: center;
    text-align: center;
}
.btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    border: none;
    border-radius: 14px;
    padding: 10px 16px;
    font-size: 14px;
    font-weight: 700;
    cursor: pointer;
    transition: .18s ease;
    color: white;
    white-space: nowrap;
}

.btn:hover {
    transform: translateY(-1px);
    opacity: .94;
}
.assistant-launch-wrap {
    margin-top: 14px;
}

.assistant-launch-btn {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    border: 1px solid #2f4773;
    background: linear-gradient(135deg, #132342, #1a2d54);
    color: #eef4ff;
    border-radius: 16px;
    padding: 12px 16px;
    font-size: 14px;
    font-weight: 700;
    cursor: pointer;
    transition: .2s ease;
    box-shadow: inset 0 0 0 1px rgba(255,255,255,.03);
}

.assistant-launch-btn:hover {
    transform: translateY(-1px);
    border-color: #5f82d1;
    background: linear-gradient(135deg, #17305b, #213b6c);
}

.assistant-icon {
    font-size: 16px;
}

.btn-add,
.btn-edit,
.btn-delete,
.btn-reset,
.btn-ghost,
.btn-sm {
    background: linear-gradient(135deg, var(--purple-2), var(--purple));
}

.search-right {
    display: flex;
    align-items: center;
    gap: 8px;
}
.assistant-window-actions {
    display: flex;
    align-items: center;
    gap: 8px;
}

.assistant-minimize,
.assistant-close {
    background: transparent;
    border: none;
    color: white;
    font-size: 18px;
    line-height: 1;
    cursor: pointer;
    width: 28px;
    height: 28px;
    border-radius: 8px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: .2s ease;
}

.assistant-minimize:hover,
.assistant-close:hover {
    background: rgba(255,255,255,.08);
}

.assistant-window.minimized {
    height: auto;
}

.assistant-window.minimized .assistant-window-messages,
.assistant-window.minimized .assistant-window-input {
    display: none;
}

.search-right input {
    width: 200px;
    padding: 8px 12px;
    font-size: 13px;
}

.btn-search {
    padding: 8px 14px;
    font-size: 13px;
    border-radius: 12px;
    background: linear-gradient(135deg, #6aa2ff, #7d74ff);
}

.btn-delete {
    background: linear-gradient(135deg, #8d8cff, #8570ff);
}

.selected-strip {
    display: none;
    align-items: center;
    gap: 8px;
    background: rgba(125,116,255,.12);
    border: 1px solid rgba(125,116,255,.24);
    color: #c7ccff;
    border-radius: 12px;
    padding: 10px 12px;
    margin-bottom: 12px;
    font-size: 13px;
}

.selected-strip.visible {
    display: flex;
}

.hint {
    margin-top: 10px;
    color: #8fa3c7;
    font-size: 13px;
    line-height: 1.6;
}

.count-pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-left: 12px;
    background: #1a2840;
    border: 1px solid #2a3d63;
    color: #9fb2d9;
    padding: 5px 12px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 700;
}
</style>
{% endblock %}

{% block body %}
<header class="topbar">
    <a href="#" class="brand">
        <img src="{{ asset('image/competences/logo.png') }}" alt="SkillSwap">
        <span>SkillSwap</span>
    </a>

    <div class="topbar-spacer"></div>

    <a href="#" class="nav-link">Accueil</a>
    <a href="{{ path('app_admin_profil') }}" class="nav-link">Profil</a>
    <a href="#" class="nav-link">Offres</a>
</header>

<main class="page">
    <div style="display:flex;align-items:center;gap:10px;margin-bottom:18px;">
        <h3 class="page-title">Compétences</h3>
        <span class="count-pill">{{ competences|length }} entrée{{ competences|length > 1 ? 's' : '' }}</span>
    </div>


    <div class="layout">
        <div class="card">
            <div class="card-title">Recherche</div>
<form method="GET" action="{{ path('competence_search') }}" class="search-bar">

    {% set attrs = {
        'email':'Email',
        'niveau':'Niveau',
        'type':'Type',
        'category':'Catégorie',
        'certification':'Certification',
        'statut':'Statut',
        'description':'Description'
    } %}

    <select name="type">
        <option value="">Tous</option>
        {% for val, label in attrs %}
            <option value="{{ val }}" {{ app.request.get('type') == val ? 'selected' : '' }}>
                {{ label }}
            </option>
        {% endfor %}
    </select>

    <div class="search-right">
        <input type="text" id="searchInput" name="q" value="{{ app.request.get('q') }}" placeholder="Rechercher...">
       <button type="submit" class="btn btn-search">
        🔍 Rechercher
    </button>
    </div>

</form>

            <div class="table-wrap">
                <table id="competenceTable">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Email</th>
                            <th>Statut</th>
                            <th>Niveau</th>
                            <th>Type</th>
                            <th>Catégorie</th>
                            <th>Certification</th>
                            <th>Expérience</th>
                            <th>Description</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for c in competences %}
                        <tr onclick="fillForm(this)"
                            data-id="{{ c.id }}"
                            data-type="{{ c.type }}"
                            data-category="{{ c.category }}"
                            data-description="{{ c.description }}"
                            data-niveau="{{ c.niveau }}"
                            data-statut="{{ c.statut }}"
                            data-annees="{{ c.anneesExperience }}"
                            data-certification="{{ c.certification }}"
                            data-email="{{ c.email }}">
                            <td>{{ c.id }}</td>
                            <td>{{ c.email }}</td>
                     <td>
                            {% set s = c.statut|lower %}

                            {% if s == 'validée' or s == 'validee' %}
                                <button
                                    type="button"
                                    class="status-link status-link-strong"
                                    onclick="sendStatusMail(this, {{ c.id }}, '{{ c.email|e('js') }}', '{{ c.statut|e('js') }}')"
                                >
                                    {{ c.statut }}
                                </button>

                            {% elseif s == 'expirée' or s == 'expiree' %}
                                <button
                                    type="button"
                                    class="status-link status-link-strong"
                                    onclick="sendStatusMail(this, {{ c.id }}, '{{ c.email|e('js') }}', '{{ c.statut|e('js') }}')"
                                >
                                    {{ c.statut }}
                                </button>

                            {% else %}
                                <button
                                    type="button"
                                    class="status-link status-link-soft is-disabled"
                                    disabled
                                >
                                    {{ c.statut }}
                                </button>
                            {% endif %}
                        </td>
                            <td>{{ c.niveau }}</td>
                            <td>{{ c.type }}</td>
                            <td>{{ c.category }}</td>
                            <td>{{ c.certification ?? '—' }}</td>
                            <td>{{ c.anneesExperience }}</td>
                            <td title="{{ c.description }}">
                                {{ c.description|length > 30 ? c.description|slice(0,30) ~ '…' : (c.description ?? '—') }}
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="9" class="empty-state">Aucune compétence enregistrée.</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        

<div class="action-bar">
