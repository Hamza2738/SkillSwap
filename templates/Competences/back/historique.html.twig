{# templates/Competences/back/historique.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Historique Compétences · SkillSwap{% endblock %}

{% block stylesheets %}
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
<style>
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

:root {
    --bg:       #080b12;
    --surface:  #0e1220;
    --surface2: #141928;
    --border:   #1e2540;
    --border2:  #2a3260;
    --accent:   #6c63ff;
    --accent2:  #a78bfa;
    --accent3:  #38bdf8;
    --green:    #22c55e;
    --red:      #ef4444;
    --orange:   #f59e0b;
    --text:     #e2e8f0;
    --muted:    #64748b;
    --radius:   12px;
    --font-head:'Syne', sans-serif;
    --font-body:'DM Sans', sans-serif;
}

html, body {
    background: var(--bg);
    color: var(--text);
    font-family: var(--font-body);
    font-size: 14px;
    min-height: 100vh;
}

/* TOPBAR */
.topbar {
    position: sticky; top: 0; z-index: 100;
    background: rgba(8,11,18,.9);
    backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--border);
    padding: 0 28px; height: 62px;
    display: flex; align-items: center; gap: 16px;
}
.brand { display:flex; align-items:center; gap:10px; text-decoration:none; }
.brand span {
    font-family: var(--font-head); font-size:1.2rem; font-weight:800;
    background: linear-gradient(135deg, var(--accent2), var(--accent3));
    -webkit-background-clip:text; -webkit-text-fill-color:transparent;
}
.topbar-spacer { flex:1; }
.nav-link {
    color:var(--muted); text-decoration:none; font-size:.85rem;
    padding:6px 14px; border-radius:8px; transition:.2s;
}
.nav-link:hover { color:var(--text); background:var(--surface2); }

/* PAGE */
.page { max-width:1600px; margin:0 auto; padding:32px 24px 60px; }
.page-header { display:flex; align-items:flex-end; gap:16px; margin-bottom:24px; }
.page-title {
    font-family:var(--font-head); font-size:2rem; font-weight:800;
    background: linear-gradient(135deg,#fff 30%,var(--accent2));
    -webkit-background-clip:text; -webkit-text-fill-color:transparent;
}
.page-subtitle { color:var(--muted); font-size:.85rem; margin-bottom:3px; }
.count-pill {
    background:var(--surface2); border:1px solid var(--border2);
    color:var(--accent2); font-family:var(--font-head);
    font-size:.8rem; font-weight:700; padding:4px 12px;
    border-radius:20px; margin-bottom:4px;
}

/* CARD */
.card {
    background:var(--surface); border:1px solid var(--border);
    border-radius:var(--radius); padding:22px;
    display:flex; flex-direction:column; gap:16px;
    position:relative; overflow:hidden;
}
.card::before {
    content:''; position:absolute; top:0; left:0; right:0; height:2px;
    background:linear-gradient(90deg,var(--accent),var(--accent3)); opacity:.6;
}
.card-title {
    font-family:var(--font-head); font-size:.95rem; font-weight:700;
    display:flex; align-items:center; gap:8px;
}
.ico {
    width:28px; height:28px; background:var(--surface2);
    border:1px solid var(--border2); border-radius:8px;
    display:grid; place-items:center; font-size:.9rem;
}

/* SEARCH BAR */
.search-bar {
    display:flex; gap:10px; flex-wrap:wrap; align-items:center;
}
input, select {
    background:var(--surface2); border:1px solid var(--border);
    color:var(--text); border-radius:8px; padding:8px 12px;
    font-family:var(--font-body); font-size:.875rem; outline:none;
    transition:.2s; width:auto;
}
input:focus, select:focus {
    border-color:var(--accent);
    box-shadow:0 0 0 3px rgba(108,99,255,.15);
}

/* DATE NAV */
.date-nav {
    display:flex; align-items:center; gap:8px;
    background:var(--surface2); border:1px solid var(--border);
    border-radius:8px; padding:4px 10px;
}
.date-nav span { color:var(--accent2); font-weight:600; font-size:.88rem; }
.nav-arrow {
    background:none; border:none; color:var(--muted);
    cursor:pointer; font-size:1rem; padding:2px 6px;
    border-radius:6px; transition:.2s;
}
.nav-arrow:hover { color:var(--text); background:var(--border); }

/* TABLE */
.table-wrap { overflow-x:auto; border-radius:10px; border:1px solid var(--border); }
table { width:100%; border-collapse:collapse; font-size:.83rem; }
thead tr { background:var(--surface2); }
thead th {
    padding:12px 14px; text-align:left;
    font-family:var(--font-head); font-size:.72rem; font-weight:700;
    color:var(--accent2); letter-spacing:.5px; text-transform:uppercase;
    border-bottom:1px solid var(--border); white-space:nowrap;
}
tbody tr { border-bottom:1px solid var(--border); transition:.15s; }
tbody tr:last-child { border-bottom:none; }
tbody tr:hover { background:rgba(108,99,255,.07); }
tbody td { padding:10px 14px; color:#94a3b8; vertical-align:middle; }

/* BADGES */
.badge {
    display:inline-flex; align-items:center; gap:5px;
    padding:3px 10px; border-radius:20px; font-size:.73rem; font-weight:600;
}
.badge::before { content:''; width:6px; height:6px; border-radius:50%; }
.badge-add    { background:rgba(34,197,94,.12);  color:var(--green);  border:1px solid rgba(34,197,94,.25); }
.badge-add::before    { background:var(--green); }
.badge-edit   { background:rgba(245,158,11,.12); color:var(--orange); border:1px solid rgba(245,158,11,.25); }
.badge-edit::before   { background:var(--orange); }
.badge-delete { background:rgba(239,68,68,.12);  color:var(--red);    border:1px solid rgba(239,68,68,.25); }
.badge-delete::before { background:var(--red); }

/* CHECKBOX */
input[type="checkbox"] {
    width:16px; height:16px; cursor:pointer;
    accent-color:var(--accent);
}

/* BUTTONS */
.btn-row { display:flex; gap:8px; flex-wrap:wrap; padding-top:4px; border-top:1px solid var(--border); }
.btn {
    display:inline-flex; align-items:center; gap:6px;
    padding:8px 16px; border-radius:8px; border:none;
    cursor:pointer; font-family:var(--font-body);
    font-size:.84rem; font-weight:600; text-decoration:none;
    transition:.2s; white-space:nowrap;
}
.btn:hover { opacity:.85; transform:translateY(-1px); }
.btn-primary { background:var(--accent); color:#fff; }
.btn-danger  { background:var(--red);    color:#fff; }
.btn-ghost   { background:var(--surface2); color:#94a3b8; border:1px solid var(--border2); }
.btn-ghost:hover { color:var(--text); }
.btn-sm { padding:6px 12px; font-size:.78rem; }

.hint { font-size:.78rem; color:var(--muted); }
.flash { padding:10px 16px; border-radius:8px; font-size:.88rem; margin-bottom:16px; }
.flash-success { background:#052e16; border:1px solid #166534; color:#4ade80; }
.flash-error   { background:#2d0a0a; border:1px solid #7f1d1d; color:#f87171; }
</style>
{% endblock %}

{% block body %}

<header class="topbar">
    <a href="{{ path('competence_list') }}" class="brand">
        <span>← SkillSwap</span>
    </a>
    <div class="topbar-spacer"></div>
    <a href="{{ path('competence_list') }}" class="nav-link">Compétences</a>
    <a href="{{ path('competence_dashboard') }}" class="nav-link">Dashboard</a>
</header>

<main class="page">

    <div class="page-header">
        <div>
            <p class="page-subtitle">Administration</p>
            <h1 class="page-title">🕓 Historique des Compétences</h1>
        </div>
        <span class="count-pill">{{ historique|length }} entrée{{ historique|length > 1 ? 's' : '' }}</span>
    </div>

    {% for msg in app.flashes('success') %}
        <div class="flash flash-success">✅ {{ msg }}</div>
    {% endfor %}
    {% for msg in app.flashes('error') %}
        <div class="flash flash-error">❌ {{ msg }}</div>
    {% endfor %}

    <div class="card">
        <div class="card-title"><span class="ico">🔍</span> Recherche &amp; Filtre</div>

        {# ── Formulaire de recherche ── #}
        <form method="GET" action="{{ path('competence_historique') }}" class="search-bar">

            <select name="attr" style="width:180px">
                <option value="Tous">Tous les attributs</option>
                {% for val in ['Action','Email','Type','Catégorie','Niveau','Statut','Certification','Description'] %}
                    <option value="{{ val }}" {{ app.request.get('attr') == val ? 'selected' : '' }}>
                        {{ val }}
                    </option>
                {% endfor %}
            </select>

            <input type="text"
                   name="q"
                   value="{{ app.request.get('q') }}"
                   placeholder="Rechercher…"
                   style="width:240px">

            {# Navigation mois #}
            <div class="date-nav">
                <a href="{{ path('competence_historique', {
                    'q':    app.request.get('q'),
                    'attr': app.request.get('attr'),
                    'month': prevMonth,
                    'year':  prevYear
                }) }}" class="nav-arrow" title="Mois précédent">◀</a>

                <span>{{ currentMonthLabel }} {{ currentYear }}</span>

                <a href="{{ path('competence_historique', {
                    'q':    app.request.get('q'),
                    'attr': app.request.get('attr'),
                    'month': nextMonth,
                    'year':  nextYear
                }) }}" class="nav-arrow" title="Mois suivant">▶</a>
            </div>

            <button type="submit" class="btn btn-primary btn-sm">Filtrer</button>
            <a href="{{ path('competence_historique') }}" class="btn btn-ghost btn-sm">✕ Reset</a>
        </form>

        {# ── Tableau ── #}
        <form method="POST" action="{{ path('competence_historique_delete_multiple') }}" id="deleteForm">
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th><input type="checkbox" id="selectAll" title="Tout sélectionner"></th>
                            <th>Action</th>
                            <th>Date</th>
                            <th>Email</th>
                            <th>Catégorie</th>
                            <th>Type</th>
                            <th>Niveau</th>
                            <th>Exp.</th>
                            <th>Statut</th>
                            <th>Certification</th>
                            <th>Description</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for h in historique %}
                        <tr>
                            <td>
                                <input type="checkbox" name="ids[]" value="{{ h.id }}" class="row-check">
                            </td>
                            <td>
                                {% set action = h.statusChange|lower %}
                                {% if 'ajout' in action %}
                                    <span class="badge badge-add">{{ h.statusChange }}</span>
                                {% elseif 'modif' in action %}
                                    <span class="badge badge-edit">{{ h.statusChange }}</span>
                                {% elseif 'supprim' in action %}
                                    <span class="badge badge-delete">{{ h.statusChange }}</span>
                                {% else %}
                                    <span class="badge badge-edit">{{ h.statusChange }}</span>
                                {% endif %}
                            </td>
                            <td>
                                {% if h.dateModification %}
                                    {{ h.dateModification|date('d/m/Y H:i') }}
                                {% else %}
                                    —
                                {% endif %}
                            </td>
                            <td>{{ h.email ?? '—' }}</td>
                            <td>{{ h.category ?? '—' }}</td>
                            <td>{{ h.type ?? '—' }}</td>
                            <td>{{ h.niveau ?? '—' }}</td>
                            <td>{{ h.anneesExperience ?? '—' }} ans</td>
                            <td>{{ h.statut ?? '—' }}</td>
                            <td>{{ h.certification ?? '—' }}</td>
                            <td>{{ h.description|u.truncate(60,'…')|default('—') }}</td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="11" style="text-align:center;padding:28px;color:var(--muted);">
                                Aucun historique trouvé.
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>

            {# ── Boutons d'action ── #}
            <div class="btn-row" style="margin-top:12px">
                <a href="{{ path('competence_historique_export_pdf') }}" class="btn btn-ghost btn-sm">
                    📄 Télécharger PDF
                </a>
                <button type="submit"
                        class="btn btn-danger btn-sm"
                        onclick="return confirmDelete()">
                    🗑 Supprimer la sélection
                </button>
                <a href="{{ path('competence_historique') }}" class="btn btn-ghost btn-sm">
                    🔄 Rafraîchir
                </a>
            </div>
        </form>

        <p class="hint">💡 Cochez les lignes à supprimer puis cliquez sur "Supprimer la sélection".</p>
    </div>

</main>
{% endblock %}

{% block javascripts %}
<script>
// ── Select All ───────────────────────────────────────────────────
document.getElementById('selectAll').addEventListener('change', function () {
    document.querySelectorAll('.row-check').forEach(cb => cb.checked = this.checked);
});

// ── Confirmation suppression ─────────────────────────────────────
function confirmDelete() {
    const checked = document.querySelectorAll('.row-check:checked').length;
    if (checked === 0) {
        alert('Veuillez sélectionner au moins une ligne.');
        return false;
    }
    return confirm(`Supprimer définitivement ${checked} ligne(s) ?`);
}
</script>
{% endblock %}
