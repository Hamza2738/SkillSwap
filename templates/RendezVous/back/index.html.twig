{% block body %}
<div class="rv-page">

    <header class="rv-topbar">
        <div class="rv-brand">
            <img src="{{ asset('image/logo.png') }}" alt="SkillSwap">
            <span>SkillSwap</span>
        </div>

        <nav class="rv-nav">
            <a href="{{ path('app_admin_competences') }}">Suivre Les competence</a>
            <a href="{{ path('app_admin_profil') }}">Profil</a>
        </nav>
    </header>

    <main class="rv-container">

        <h1>Gestion des Rendez-vous&nbsp;&nbsp; Postulations</h1>

        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="rv-alert rv-alert-{{ label }}">
                    {{ message }}
                </div>
            {% endfor %}
        {% endfor %}

        <div class="rv-grid">

            <section class="rv-card">
                <h2>Rendez-vous (Admin)</h2>

                <form method="get" class="rv-search">
                    <select name="filter">
                        <option value="Tous" {{ filter == 'Tous' ? 'selected' : '' }}>Tous</option>
                        <option value="Titre" {{ filter == 'Titre' ? 'selected' : '' }}>Titre</option>
                        <option value="Compétence" {{ filter == 'Compétence' ? 'selected' : '' }}>Compétence</option>
                        <option value="Type" {{ filter == 'Type' ? 'selected' : '' }}>Type</option>
                    </select>

                    <input type="text" name="search" value="{{ search }}" placeholder="Rechercher...">
                    <button type="submit">OK</button>
                </form>

                <div class="rv-table-box">
                    <table class="rv-table">
                        <thead>
                            <tr>
                                <th>Date de Rendez vous</th>
                                <th>Titre</th>
                                <th>Nombre de places</th>
                                <th>Email</th>
                                <th>Type</th>
                                <th>Compétence</th>
                                <th>Date de Création</th>
                            </tr>
                        </thead>

                        <tbody>
                        {% for rv in rendezVous %}
                            <tr class="{{ selectedRv and selectedRv.idRendezVous == rv.idRendezVous ? 'selected' : '' }}"
                                onclick="window.location.href='{{ path('app_admin_rendez_vous', {rv: rv.idRendezVous, filter: filter, search: search}) }}'">
                                <td>{{ rv.dateRendezVous ? rv.dateRendezVous|date('d/m/Y à H:i') : '' }}</td>
                                <td>{{ rv.titre }}</td>
                                <td>{{ rv.nombrePlaces }}</td>
                                <td>{{ rv.mailUser }}</td>
                                <td>{{ rv.type }}</td>
                                <td>{{ rv.competence }}</td>
                                <td>{{ rv.dateCreationRendezVous ? rv.dateCreationRendezVous|date('d/m/Y à H:i') : '' }}</td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="7" class="rv-empty">Aucun rendez-vous trouvé</td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>

                <h2>Formulaire rendez-vous</h2>

                <form method="post" class="rv-form">
                    <input type="hidden" name="id_rendez_vous" value="{{ selectedRv ? selectedRv.idRendezVous : '' }}">
                    <input type="hidden" name="selected_rv" value="{{ selectedRv ? selectedRv.idRendezVous : '' }}">

                    <label>Titre</label>
                    <input name="titre" value="{{ selectedRv ? selectedRv.titre : '' }}" required>

                    <label>Description</label>
                    <textarea name="description" rows="3">{{ selectedRv ? selectedRv.description : '' }}</textarea>

                    <label>Compétence</label>
                    <input name="competence" value="{{ selectedRv ? selectedRv.competence : '' }}" required>

                    <div class="rv-form-row">
                        <div>
                            <label>Date</label>
                            <input
                                type="text"
                                class="rv-date-picker js-rv-datepicker"
                                name="date_rendez_vous"
                                placeholder="jj/mm/aaaa HH:mm"
                                value="{{ selectedRv and selectedRv.dateRendezVous ? selectedRv.dateRendezVous|date('Y-m-d\\TH:i') : '' }}"
                                required
                            >
                        </div>

                        <div>
                            <label>Nombre de places</label>
                            <input type="number"
                                   name="nombre_places"
                                   min="1"
                                   value="{{ selectedRv ? selectedRv.nombrePlaces : '' }}"
                                   required>
                        </div>
                    </div>

                    <label>Type</label>
                    <select name="type" required>
                        <option value="">Choisir...</option>
                        <option value="presentiel" {{ selectedRv and selectedRv.type == 'presentiel' ? 'selected' : '' }}>presentiel</option>
                        <option value="distance" {{ selectedRv and selectedRv.type == 'distance' ? 'selected' : '' }}>distance</option>
                    </select>

                    <div class="rv-actions">
                        <button class="rv-btn" name="action" value="add">Ajouter</button>

                        <button class="rv-btn secondary"
                                name="action"
                                value="update"
                                {{ selectedRv ? '' : 'disabled' }}>
                            Modifier
                        </button>

                        <button class="rv-btn danger"
                                name="action"
                                value="delete"
                                onclick="return confirm('Supprimer ce rendez-vous ?')"
                                {{ selectedRv ? '' : 'disabled' }}>
                            Supprimer
                        </button>

                        <a class="rv-btn purple" href="{{ path('app_admin_rendez_vous') }}">Vider</a>
                    </div>
                </form>
            </section>

            <section class="rv-card">
                <h2>Postulations du rendez-vous sélectionné</h2>

                <div class="rv-table-box post-table">
                    <table class="rv-table">
                        <thead>
                            <tr>
                                <th>Statut</th>
                                <th>Email</th>
                                <th>Nom</th>
                                <th>Prénom</th>
                                <th>Rôle</th>
                                <th>CV</th>
                                <th>Message</th>
                                <th>Date de postulation</th>
                                <th>Analyse IA</th>
                                <th>Annulation</th>
                            </tr>
                        </thead>

                        <tbody>
                        {% for post in postulations %}
                            <tr>
                                <td>
                                    <span class="status status-{{ post.status }}">
                                        {{ post.status }}
                                    </span>
                                </td>

                                <td>{{ post.mailUser }}</td>
                                <td>{{ post.nom }}</td>
                                <td>{{ post.prenom }}</td>
                                <td>{{ post.role }}</td>

                                <td>
                                    {% if post.cv %}
                                        <a href="{{ asset(post.cv) }}" target="_blank">Télécharger CV</a>
                                    {% else %}
                                        -
                                    {% endif %}
                                </td>

                                <td>{{ post.message }}</td>

                                <td>{{ post.datePostulation ? post.datePostulation|date('d/m/Y à H:i') : '' }}</td>

                               <td>
    <a href="javascript:void(0)"
       onclick="event.stopPropagation(); analyserIa({{ post.idPostulation }});">
        Analyser IA
    </a>
</td>

                                <td>
                                    <form method="post">
                                        <input type="hidden" name="id_postulation" value="{{ post.idPostulation }}">
                                        <input type="hidden" name="selected_rv" value="{{ selectedRv ? selectedRv.idRendezVous : '' }}">
                                        <button class="link-btn"
                                                name="action"
                                                value="delete_postulation"
                                                onclick="return confirm('Supprimer cette postulation ?')">
                                            Annulation
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="10" class="rv-empty">Aucun contenu dans la table</td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>

                <div id="ia-result-box" class="ia-result-box" style="display:none;">
                    <h2>Résultat Analyse IA</h2>
                    <pre id="ia-result-content" class="ia-result-content"></pre>
                </div>

                <div class="rv-actions">
                    {% if postulations|length > 0 %}
                        {% for post in postulations %}
                            <form method="post" class="inline-form">
                                <input type="hidden" name="id_postulation" value="{{ post.idPostulation }}">
                                <input type="hidden" name="selected_rv" value="{{ selectedRv ? selectedRv.idRendezVous : '' }}">
                                <button class="rv-btn" name="action" value="accept">Accepter {{ post.nom }}</button>
                                <button class="rv-btn secondary" name="action" value="refuse">Refuser</button>
                            </form>
                        {% endfor %}
                    {% else %}
                        <button class="rv-btn" disabled>Accepter</button>
                        <button class="rv-btn secondary" disabled>Refuser</button>
                    {% endif %}
                </div>

                <p class="rv-hint">
                    Tip : sélectionne un rendez-vous à gauche pour voir ses postulations.
                </p>

                <hr>
            </section>

        </div>
    </main>
</div>

<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
<script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/fr.js"></script>

<script>
document.addEventListener('DOMContentLoaded', function () {
    flatpickr('.js-rv-datepicker', {
        enableTime: true,
        time_24hr: true,
        minuteIncrement: 5,
        dateFormat: 'Y-m-d\\TH:i',
        altInput: false,
        locale: 'fr',
        allowInput: true
    });
});
function analyserIa(idPostulation) {
    const box = document.getElementById('ia-result-box');
    const content = document.getElementById('ia-result-content');

    box.style.display = 'block';
    content.innerHTML = '<span class="ia-loading">Analyse IA en cours...</span>';

    fetch('/admin/rendez-vous/analyse-ia/' + idPostulation)
        .then(function (response) {
            if (!response.ok) {
                throw new Error('Erreur HTTP : ' + response.status);
            }
            return response.json();
        })
        .then(function (data) {
            if (data.success) {
                content.textContent = data.analyse;
            } else {
                content.textContent = data.message;
            }
        })
        .catch(function (error) {
            content.textContent = 'Erreur lors de l’analyse IA : ' + error.message;
        });
}
</script>
{% endblock %}