{% extends 'base.html.twig' %}

{% block title %}Gestion des Rendez-vous{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/rendezvous/back/style.css') }}">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">

    <style>
       .rv-brand {
    display: flex;
    align-items: center;
    gap: 14px;
    color: #ffffff;
    font-size: 20px;
    font-weight: 400 !important;
}

/* Enlever le gras dans le tableau Rendez-vous */
.rv-card:first-child .rv-table thead th {
    font-weight: 400 !important;
    font-size: 12px !important;
}
        .rv-brand img {
            width: 50px;
            height: 50px;
            object-fit: contain;
        }

        .rv-logo {
            display: none;
        }

        .rv-btn.purple {
            background: linear-gradient(135deg, #7b61ff, #9f7aea);
            color: white;
            border: none;
        }

        .rv-btn.purple:hover {
            opacity: 0.9;
        }

        .ia-result-box {
            margin-top: 20px;
            padding: 18px;
            border-radius: 14px;
            background: #0b1220;
            border: 1px solid #22304a;
            color: #ffffff;
        }

        .ia-result-box h2 {
            margin-bottom: 12px;
            color: #ffffff;
        }

        .ia-result-content {
            white-space: pre-wrap;
            font-family: inherit;
            line-height: 1.7;
            background: #111827;
            border: 1px solid #334155;
            padding: 15px;
            border-radius: 10px;
            color: #e5e7eb;
        }

      .ia-loading {
    color: #93c5fd;
    font-weight: 400 !important;
}


/* Corriger affichage colonnes tableau rendez-vous sans changer le style général */
.rv-card:first-child .rv-table {
    min-width: 1050px;
    table-layout: fixed;
}

.rv-card:first-child .rv-table th,
.rv-card:first-child .rv-table td {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    vertical-align: middle;
}

/* Largeur de chaque colonne du tableau rendez-vous */
.rv-card:first-child .rv-table th:nth-child(1),
.rv-card:first-child .rv-table td:nth-child(1) {
    width: 170px;
}

.rv-card:first-child .rv-table th:nth-child(2),
.rv-card:first-child .rv-table td:nth-child(2) {
    width: 130px;
}

.rv-card:first-child .rv-table th:nth-child(3),
.rv-card:first-child .rv-table td:nth-child(3) {
    width: 140px;
}

.rv-card:first-child .rv-table th:nth-child(4),
.rv-card:first-child .rv-table td:nth-child(4) {
    width: 180px;
}

.rv-card:first-child .rv-table th:nth-child(5),
.rv-card:first-child .rv-table td:nth-child(5) {
    width: 120px;
}

.rv-card:first-child .rv-table th:nth-child(6),
.rv-card:first-child .rv-table td:nth-child(6) {
    width: 140px;
}

.rv-card:first-child .rv-table th:nth-child(7),
.rv-card:first-child .rv-table td:nth-child(7) {
    width: 180px;
}

/* Même style des liens si un jour tu ajoutes des liens dans tableau rendez-vous */
.rv-card:first-child .rv-table a {
    color: #7aa2ff;
    text-decoration: none;
    font-weight: 400 !important;
}

.rv-card:first-child .rv-table a:hover {
    color: #ffffff;
    text-decoration: underline;
}
