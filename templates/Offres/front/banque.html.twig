{% extends 'base.html.twig' %}

{% block title %}Paiement bancaire{% endblock %}

{% block body %}

<style>
    * {
        box-sizing: border-box;
    }

    html,
    body {
        margin: 0;
        min-height: 100%;
        background: #020817;
        font-family: 'Inter', 'Segoe UI', Arial, sans-serif;
    }

    body {
        color: #f8fafc;
    }

    .bank-page {
        min-height: 100vh;
        background:
            radial-gradient(circle at top left, rgba(37, 99, 235, 0.18), transparent 34%),
            linear-gradient(135deg, #020817 0%, #0b1220 45%, #111827 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px 20px;
        color: #f8fafc;
    }

    .bank-container {
        width: 100%;
        max-width: 1180px;
        min-height: 720px;
        background: rgba(2, 8, 23, 0.88);
        border: 1px solid rgba(51, 65, 85, 0.95);
        border-radius: 26px;
        display: grid;
        grid-template-columns: 1.5fr 0.8fr;
        gap: 55px;
        position: relative;
        padding: 34px;
        box-shadow: 0 30px 90px rgba(0, 0, 0, 0.42);
    }

    .bank-close {
        position: fixed;
        top: 18px;
        right: 24px;
        width: 44px;
        height: 44px;
        border: 1px solid #334155;
        border-radius: 12px;
        background: #0f172a;
        color: #ffffff;
        font-size: 32px;
        line-height: 1;
        cursor: pointer;
        transition: 0.2s ease;
        z-index: 20;
    }

    .bank-close:hover {
        background: #1e293b;
        color: #60a5fa;
        transform: translateY(-1px);
    }

    .payment-left {
        padding: 10px 0;
    }

    .bank-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 45px;
    }

    .brand {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .brand-icon {
        width: 52px;
        height: 52px;
        border-radius: 50%;
        background: linear-gradient(135deg, #2563eb, #0ea5e9);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #ffffff;
        font-size: 28px;
        font-weight: 600;
        box-shadow: 0 14px 35px rgba(37, 99, 235, 0.35);
    }

    .brand-name {
        font-size: 25px;
        letter-spacing: -1px;
        color: #ffffff;
        font-weight: 700;
    }

    .brand-name span {
        color: #ffffff;
    }

    .brand-name small {
        color: #94a3b8;
        font-weight: 500;
    }

    .timer {
        display: flex;
        align-items: center;
        gap: 4px;
        font-size: 35px;
        color: #ffffff;
    }

    .timer-box {
        width: 38px;
        height: 48px;
        border-radius: 8px;
        background: #1e293b;
        border: 1px solid #334155;
        color: #ffffff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.07);
    }

    .form-group {
        display: grid;
        grid-template-columns: 280px 1fr;
        align-items: center;
        gap: 28px;
        margin-bottom: 34px;
    }

    .form-info h3 {
        margin: 0 0 10px;
        color: #ffffff;
        font-size: 20px;
        font-weight: 700;
    }

    .form-info p {
        margin: 0;
        color: #94a3b8;
        font-size: 15px;
        line-height: 1.5;
    }

    .field-wrapper {
        position: relative;
    }

    .bank-input {
        width: 100%;
        height: 70px;
        border: 1px solid #334155;
        border-radius: 13px;
        background: #1e293b;
        color: #f8fafc;
        font-size: 18px;
        padding: 0 55px 0 22px;
        outline: none;
        transition: 0.2s ease;
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.04);
    }

    .bank-input::placeholder {
        color: #94a3b8;
        opacity: 1;
    }

    .bank-input:focus {
        border-color: #3b82f6;
        background: #172033;
        box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.16);
    }

    .card-number-field {
        padding-left: 90px;
        color: #f8fafc;
        letter-spacing: 3px;
    }

    .mastercard-small {
        position: absolute;
        left: 22px;
        top: 50%;
        transform: translateY(-50%);
        width: 38px;
        height: 24px;
    }

    .mastercard-small::before,
    .mastercard-small::after {
        content: "";
        position: absolute;
        top: 4px;
        width: 19px;
        height: 19px;
        border-radius: 50%;
    }

    .mastercard-small::before {
        left: 2px;
        background: #ef4444;
    }

    .mastercard-small::after {
        right: 2px;
        background: #f59e0b;
        opacity: 0.95;
    }

    .verified-icon {
        position: absolute;
        right: 22px;
        top: 50%;
        transform: translateY(-50%);
        width: 29px;
        height: 29px;
        border-radius: 50%;
        background: #0ea5e9;
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 15px;
        font-weight: 700;
    }

    .dots-icon {
        position: absolute;
        right: 22px;
        top: 50%;
        transform: translateY(-50%);
        width: 28px;
        height: 28px;
        background-image: radial-gradient(#94a3b8 2px, transparent 2px);
        background-size: 8px 8px;
        opacity: 0.8;
    }

    .short-inputs {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 52px;
    }

    .short-inputs .bank-input {
        text-align: center;
        padding: 0 10px;
        font-weight: 700;
    }

    .short-inputs .active {
        border: 2px solid #3b82f6;
        background: #172033;
        color: #60a5fa;
    }

    .edit-link {
        position: absolute;
        right: 0;
        top: -38px;
        color: #60a5fa;
        font-size: 16px;
        text-decoration: none;
        display: flex;
        align-items: center;
        gap: 8px;
        font-weight: 600;
    }

    .edit-link:hover {
        color: #93c5fd;
    }

    .pay-btn {
        width: 100%;
        height: 82px;
        margin-top: 10px;
        background: linear-gradient(135deg, #2563eb, #0ea5e9);
        color: #ffffff;
        border: none;
        border-radius: 14px;
        font-size: 26px;
        font-weight: 700;
        cursor: pointer;
        transition: 0.2s ease;
        box-shadow: 0 18px 40px rgba(37, 99, 235, 0.28);
    }

    .pay-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 22px 50px rgba(14, 165, 233, 0.32);
        filter: brightness(1.05);
    }

    .payment-right {
        display: flex;
        align-items: stretch;
        justify-content: center;
        padding: 18px 0;
    }

    .receipt {
        width: 340px;
        background: #0f172a;
        border: 1px solid #334155;
        border-radius: 22px;
        min-height: 640px;
        position: relative;
        overflow: hidden;
        box-shadow: 0 24px 70px rgba(0, 0, 0, 0.35);
    }

    .receipt::before,
    .receipt::after {
        content: "";
        position: absolute;
        top: 475px;
        width: 38px;
        height: 38px;
        border-radius: 50%;
        background: #020817;
        z-index: 3;
    }

    .receipt::before {
        left: -19px;
    }

    .receipt::after {
        right: -19px;
    }

    .card-visual {
        width: 245px;
        height: 355px;
        background: linear-gradient(160deg, #f8fafc 0%, #ffffff 52%, #e2e8f0 100%);
        border-radius: 18px;
        margin: 0 auto;
        position: relative;
        top: 0;
        padding: 45px 30px;
        box-shadow: 0 20px 55px rgba(0, 0, 0, 0.26);
    }

    .card-visual::before {
        content: "";
        position: absolute;
        top: -8px;
        left: 50%;
        transform: translateX(-50%);
        width: 72px;
        height: 8px;
        border-radius: 4px;
        background: #2563eb;
    }

    .chip {
        width: 36px;
        height: 44px;
        border-radius: 8px;
        background: linear-gradient(135deg, #cbd5e1, #f8fafc);
        border: 1px solid #cbd5e1;
        margin-bottom: 95px;
    }

    .wifi {
        position: absolute;
        top: 52px;
        right: 28px;
        font-size: 25px;
        transform: rotate(90deg);
        color: #0f172a;
    }

    .card-holder {
        color: #0f172a;
        font-size: 16px;
        margin-bottom: 10px;
        font-weight: 600;
    }

    .card-digits {
        color: #0f172a;
        font-size: 21px;
        letter-spacing: 2px;
        margin-bottom: 35px;
        font-weight: 700;
    }

    .card-bottom {
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .card-date {
        font-size: 17px;
        font-weight: 700;
        color: #0f172a;
    }

    .mastercard-big {
        width: 48px;
        height: 30px;
        position: relative;
    }

    .mastercard-big::before,
    .mastercard-big::after {
        content: "";
        position: absolute;
        top: 3px;
        width: 27px;
        height: 27px;
        border-radius: 50%;
    }

    .mastercard-big::before {
        left: 0;
        background: #ef4444;
    }

    .mastercard-big::after {
        right: 0;
        background: #f59e0b;
        opacity: 0.95;
    }

    .receipt-info {
        padding: 45px 40px 25px;
    }

    .info-row {
        display: flex;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 22px;
        color: #f8fafc;
        font-size: 16px;
    }

    .info-row span:first-child {
        color: #cbd5e1;
        font-weight: 500;
    }

    .info-row span:last-child {
        color: #ffffff;
        font-weight: 700;
        text-align: right;
    }

    .dashed-line {
        border-top: 1px dashed #475569;
        margin: 22px 0 0;
    }

    .total-box {
        padding: 35px 40px;
        background: #111827;
    }

    .total-label {
        color: #94a3b8;
        font-size: 16px;
        margin-bottom: 12px;
    }

    .total-price {
        display: flex;
        align-items: flex-end;
        gap: 8px;
        color: #ffffff;
    }

    .total-price strong {
        font-size: 36px;
        line-height: 1;
        font-weight: 800;
        color: #ffffff;
    }

    .total-price sup {
        font-size: 22px;
        font-weight: 700;
        margin-bottom: 5px;
        color: #ffffff;
    }

    .total-price span {
        color: #94a3b8;
        font-size: 15px;
        margin-bottom: 5px;
    }

    .success-alert {
        margin-bottom: 25px;
        padding: 18px 20px;
        border-radius: 14px;
        background: rgba(34, 197, 94, 0.12);
        color: #86efac;
        border: 1px solid rgba(34, 197, 94, 0.35);
        font-size: 16px;
        font-weight: 600;
    }

    @media (max-width: 992px) {
        .bank-container {
            grid-template-columns: 1fr;
            gap: 20px;
            padding: 24px;
        }

        .form-group {
            grid-template-columns: 1fr;
            gap: 15px;
        }

        .payment-right {
            padding-top: 10px;
        }
    }

    .bank-skillswap-brand {
    display: flex;
    align-items: center;
    gap: 8px;
}

.bank-skillswap-brand img {
    width: 34px !important;
    height: 34px !important;
    object-fit: contain;
}

.bank-skillswap-brand span {
    color: #ffffff;
    font-size: 22px !important;
    font-weight: 800;
    letter-spacing: -0.3px;
    text-shadow: 0 2px 0 rgba(0, 0, 0, 0.45);
}

.bank-skillswap-brand img {
    width: 28px !important;
    height: 28px !important;
}

.bank-skillswap-brand span {
    font-size: 19px !important;
}

        .bank-container {
            padding: 18px;
            border-radius: 18px;
        }

        .bank-header {
            flex-direction: column;
            align-items: flex-start;
            gap: 25px;
        }

        .short-inputs {
            gap: 15px;
        }

        .pay-btn {
            height: 68px;
            font-size: 22px;
        }

        .receipt {
            width: 100%;
        }
        .bank-skillswap-brand {
    display: flex;
    align-items: center;
    gap: 8px;
}

.bank-skillswap-brand img {
    width: 34px !important;
    height: 34px !important;
    object-fit: contain;
}

.bank-skillswap-brand span {
    color: #ffffff;
    font-size: 22px !important;
    font-weight: 800;
    letter-spacing: -0.3px;
    text-shadow: 0 2px 0 rgba(0, 0, 0, 0.45);
}
.bank-skillswap-brand img {
    width: 28px !important;
    height: 28px !important;
}

.bank-skillswap-brand span {
    font-size: 19px !important;
}
    }
</style>

<div class="bank-page">
    <button class="bank-close" onclick="window.location.href='/offres/front'">×</button>

    <div class="bank-container">

        <div class="payment-left">

            <div class="bank-header">
                <div class="brand bank-skillswap-brand">
    <img src="{{ asset('image/logo.png') }}" alt="SkillSwap">
    <span>SkillSwap</span>
</div>

              <div class="timer" id="payment-timer">
    <span class="timer-box" id="min-1">0</span>
    <span class="timer-box" id="min-2">1</span>
    <span>:</span>
    <span class="timer-box" id="sec-1">3</span>
    <span class="timer-box" id="sec-2">0</span>
</div>
            </div>

            {% if success is defined and success %}
                <div class="success-alert">
                    Paiement effectué avec succès.
                </div>
            {% endif %}

            {% for message in app.flashes('success') %}
                <div class="success-alert">
                    {{ message }}
                </div>
            {% endfor %}

            <form method="post">

                <div class="form-group">
                    <div class="form-info">
                        <h3>Card Number</h3>
                        <p>Enter the 16-digit card number on the card</p>
                    </div>

                    <div class="field-wrapper">
                        <a href="#" class="edit-link">✎ Edit</a>
                        <span class="mastercard-small"></span>
                        <input
                            type="text"
                            name="card_number"
                            class="bank-input card-number-field"
                            placeholder="3416 - 6257 - 3365 - 3446"
                            maxlength="25"
                            required
                        >
                        <span class="verified-icon">✓</span>
                    </div>
                </div>

                <div class="form-group">
                    <div class="form-info">
                        <h3>CVV Number</h3>
                        <p>Enter the 3 or 4 digit number on the card</p>
                    </div>

                    <div class="field-wrapper">
                        <input
                            type="text"
                            name="cvv"
                            class="bank-input"
                            placeholder="446"
                            maxlength="4"
                            required
                            style="text-align:center;font-weight:700;"
                        >
                        <span class="dots-icon"></span>
                    </div>
                </div>

                <div class="form-group">
                    <div class="form-info">
                        <h3>Expiry Date</h3>
                        <p>Enter the expiration date of the card</p>
                    </div>

                    <div class="short-inputs">
                        <input
                            type="text"
                            name="expiry_month"
                            class="bank-input"
                            placeholder="10"
                            maxlength="2"
                            required
                        >

                        <input
                            type="text"
                            name="expiry_year"
                            class="bank-input active"
                            placeholder="24"
                            maxlength="4"
                            required
                        >
                    </div>
                </div>

                <div class="form-group">
                    <div class="form-info">
                        <h3>Password</h3>
                        <p>Enter your Dynamic password</p>
                    </div>

                    <div class="field-wrapper">
                        <input
                            type="password"
                            name="dynamic_password"
                            class="bank-input"
                            placeholder="••••••••"
                            required
                        >
                        <span class="dots-icon"></span>
                    </div>
                </div>

                <input type="hidden" name="card_holder" value="{{ app.user ? app.user.nom ~ ' ' ~ app.user.prenom : 'Client SkillSwap' }}">
                <input type="hidden" name="company" value="SkillSwap">

                <input type="hidden" name="mode_paiement" value="{{ app.request.query.get('mode_paiement', 'carte') }}">
                <input type="hidden" name="message" value="{{ app.request.query.get('message', '') }}">
                <input type="hidden" name="lettre_motivation" value="{{ app.request.query.get('lettre_motivation', '') }}">

                <button type="submit" class="pay-btn">Pay Now</button>
            </form>
        </div>

        <div class="payment-right">
            <div class="receipt">

                <div class="card-visual">
                    <div class="chip"></div>
                    <div class="wifi">⌕</div>

                    <div class="card-holder">
                        {{ app.user ? app.user.nom ~ ' ' ~ app.user.prenom : 'Client SkillSwap' }}
                    </div>

                    <div class="card-digits">
                        •••• 3456
                    </div>

                    <div class="card-bottom">
                        <div class="card-date">09/24</div>
                        <div class="mastercard-big"></div>
                    </div>
                </div>

                <div class="receipt-info">
                    <div class="info-row">
                        <span>Company</span>
                        <span>SkillSwap</span>
                    </div>

                    <div class="info-row">
                        <span>Order Number</span>
                        <span>{{ random(1000000, 9999999) }}</span>
                    </div>

                    <div class="info-row">
                        <span>Product</span>
                        <span>{{ offre.titre }}</span>
                    </div>

                    <div class="info-row">
                        <span>VAT (20%)</span>
                        <span>
                            ${{ ((offre.prix * 20) / 100)|number_format(2, '.', ',') }}
                        </span>
                    </div>
                </div>

                <div class="dashed-line"></div>

                <div class="total-box">
                    <div class="total-label">You have to Pay</div>

                    <div class="total-price">
                        <strong>{{ offre.prix|number_format(0, '.', ',') }}</strong>
                        <sup>.00</sup>
                        <span>USD</span>
                    </div>
                </div>

            </div>
        </div>

    </div>
</div>
<script>
document.addEventListener('DOMContentLoaded', function () {
    let totalSeconds = 90;

    const min1 = document.getElementById('min-1');
    const min2 = document.getElementById('min-2');
    const sec1 = document.getElementById('sec-1');
    const sec2 = document.getElementById('sec-2');

    function updateTimerDisplay() {
        const minutes = Math.floor(totalSeconds / 60);
        const seconds = totalSeconds % 60;

        const timerText = String(minutes).padStart(2, '0') + String(seconds).padStart(2, '0');

        min1.textContent = timerText[0];
        min2.textContent = timerText[1];
        sec1.textContent = timerText[2];
        sec2.textContent = timerText[3];
    }

    updateTimerDisplay();

    const countdown = setInterval(function () {
        totalSeconds--;

        updateTimerDisplay();

        if (totalSeconds <= 0) {
            clearInterval(countdown);
          window.location.href = "/offres/front";
        }
    }, 1000);
});
</script>
{% endblock %}